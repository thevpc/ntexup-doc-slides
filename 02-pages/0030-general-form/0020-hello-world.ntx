content-slide(title:"Hello World", section:"Get started"){
    body{
        sectionLabel("Three ways to say hello")
        grid(2, 3,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.6])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                "Hello World"
            }
            miniCodeNTexup(""" "Hello World" """, fontSize:2.4%P)

            miniPage{
                text("""
                    Hello ##World##
                    Hello ###World###
                    Hello ####World####
                """, font-size:3.2%P, color:documentTextPrimary)
            }
            miniCodeNTexup(```
                text("""
                    Hello ##World##
                    Hello ###World###
                    Hello ####World####
                """, font-size:3.2%P,
                   color:documentTextPrimary)
            ```, fontSize:2.3%P)

            miniPage{
                ul(font-size:3.2%P){
                    text("Hello **World**")
                    text("Hello *World*")
                    text("Hello `World`")
                }
            }
            miniCodeNTexup(```
                ul(font-size:3.2%P){
                    text("Hello **World**")
                    text("Hello *World*")
                    text("Hello `World`")
                }
            ```, fontSize:2.3%P)
        }
    }
}

content-slide(title:"Hello World", section:"Chapter 01 · Get started"){
    body{
        sectionLabel("Four ways to say hello")
        grid(2, 4,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.6],
            rows-weight:[0.8, 0.9, 1.25, 1.05])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                ¶ Hello World
            }
            miniCodeNTexup("""
                ¶ Hello World
            """, fontSize:2.2%P)

            miniPage{
                ¶¶ Hello World
                ¶¶ This is one paragraph.
            }
            miniCodeNTexup("""
                ¶¶ Hello World
                ¶¶ This is one paragraph.
            """, fontSize:2.2%P)

            miniPage{
                styles{
                    ntf{ source-primary-color:documentColors }
                }
                ntf("""
                    Hello ##World##
                    Hello ###World###
                    Hello ####World####
                """, font-size:2.8%P, color:documentTextPrimary)
            }
            miniCodeNTexup(```
                styles{
                  ntf{source-primary-color:documentColors}
                }
                ntf("""
                  Hello ##World##
                  Hello ###World###
                  Hello ####World####
                """, font-size:2.8%P,
                   color:documentTextPrimary)
            ```, fontSize:1.45%P)

            miniPage{
                ul(font-size:2.8%P){
                    text("Hello **World**")
                    text("Hello *World*")
                    text("Hello `World`")
                }
            }
            miniCodeNTexup(```
                ul(font-size:2.8%P){
                    text("Hello **World**")
                    text("Hello *World*")
                    text("Hello `World`")
                }
            ```, fontSize:1.9%P)
        }
    }
}

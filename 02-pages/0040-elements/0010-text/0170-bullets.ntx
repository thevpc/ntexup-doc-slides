content-slide(title:"Bullets", section:"Text & rich content"){
    body{
        sectionLabel("TSON markers · unordered, ordered, and nested lists")
        grid(2, 3,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.25])
        {
            miniPage{
                ul(font-size:2.2%P){
                    • "Circle marker"
                    [.] "Dot marker"
                    [..] "Nested dot"
                }
            }
            miniCodeNTexup("""
                ul(font-size:2.2%P){
                  • "Circle marker"
                  [.] "Dot marker"
                  [..] "Nested dot"
                }
            """, fontSize:2.1%P)

            miniPage{
                ul(font-size:2.2%P){
                    • "Parent item"
                    •• "Child one"
                    •• "Child two"
                    • "Sibling item"
                }
            }
            miniCodeNTexup("""
                ul(font-size:2.2%P){
                  • "Parent item"
                  •• "Child one"
                  •• "Child two"
                  • "Sibling item"
                }
            """, fontSize:2.1%P)

            miniPage{
                ol(numbering:"a", font-size:2.2%P){
                    ▪ "Square shorthand"
                    [#] "Hash shorthand"
                }
            }
            miniCodeNTexup("""
                ol(numbering:"a", font-size:2.2%P){
                  ▪ "Square shorthand"
                  [#] "Hash shorthand"
                }
            """, fontSize:2.1%P)
        }
    }
}

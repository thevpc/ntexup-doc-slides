content-slide(title:"Bullets", section:"Text & rich content"){
    body{
        sectionLabel("Unordered, nested, and ordered lists")
        grid(2, 3,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.2])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                ul(font-size:3%P){
                    text("Hello ##World##")
                    text("Hello ###World###")
                    text("Hello ####World####")
                }
            }
            miniCodeNTexup("""
                ul(font-size:3%P){
                    text("Hello ##World##")
                    text("Hello ###World###")
                    text("Hello ####World####")
                }
            """, fontSize:2.2%P)

            miniPage{
                ul(font-size:3%P){
                    text("Hello ##World##")
                    ul{
                        text("Sub 1")
                        text("Sub 2")
                    }
                    text("Hello ###World###")
                    text("Hello ####World####")
                }
            }
            miniCodeNTexup("""
                ul(font-size:3%P){
                    text("Hello ##World##")
                    ul{
                        text("Sub 1")
                        text("Sub 2")
                    }
                    text("Hello ###World###")
                    text("Hello ####World####")
                }
            """, fontSize:2.2%P)

            miniPage{
                ol(font-size:3%P){
                    text("Hello ##World##")
                    ol{
                        text("Sub 1")
                        text("Sub 2")
                    }
                    text("Hello ###World###")
                    text("Hello ####World####")
                }
            }
            miniCodeNTexup("""
                ol(font-size:3%P){
                    text("Hello ##World##")
                    ol{
                        text("Sub 1")
                        text("Sub 2")
                    }
                    text("Hello ###World###")
                    text("Hello ####World####")
                }
            """, fontSize:2.2%P)
        }
    }
}

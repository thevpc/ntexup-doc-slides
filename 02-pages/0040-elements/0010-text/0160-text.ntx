content-slide(title:"Rich Text",variant:3){
    body{
        grid(4,2,columns-weight:[1,2]){
            styles:{
                "*": {margin:2}
                source:{
                    at:left
                }
            }

            // Row
            miniPage{
                styles:{
                    "*":{font-size:3%P}
                }
                grid(1,2){
                    "Hello World"
                    text("Hello World")
                    text("Hello World",font-italic)
                    text("Hello World",font-bold)
                }
            }
            miniCodeNTexup(
                """
                "Hello World"
                text("Hello World")
                text("Hello World",
                    font-italic)
                text("Hello World",
                    font-bold)
                """)


            // Row
            miniPage{
                styles:{
                    "*":{font-size:3%P}
                }
                grid(1,2){
                    """
                        **Bold X**
                        __Italic Y__
                        #Title 1#
                        ##Title 2##
                        ###Title 3###
                    """
                }
            }
            miniCodeNTexup(
                ```
                """
                **Bold X**
                __Italic Y__
                #Title 1#
                ##Title 2##
                ###Title 3###
                """
                ```
                )


            // Row
            miniPage{
                styles:{
                    "*":{font-size:3%P}
                }
                grid(1,2){
                    """
                    [[ntf: ##:p1: hello##]] world
                    """
                }
            }
            miniCodeNTexup(
                ```
                    """
                    [[ntf: ##:p1: hello##]] world
                    """
                ```)


            // Row
            miniPage{
                styles:{
                    "*":{font-size:3%P}
                }
                grid(1,2){
                    """
                        #Equation 1 =
                        [[eq: X²=\sin(πx) ]]
                        ##Equation 2## =
                        [[eq: X^2=\sin\left(\pi x\right) ]]
                        ###Equation 3### =
                        [[eq: X^2=\sin(x) ]]
                    """
                }
            }
            miniCodeNTexup(
                ```
                """
                #Equation 1# =
                [[eq: X²=\sin(πx) ]]
                ##Equation 2## =
                [[eq: X^2=\sin\left(\pi x\right)]]
                ###Equation 3### =
                [[eq: X^2=\sin(x)]]
                """
                ```
                )

        }
    }

}

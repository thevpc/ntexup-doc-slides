content-slide(title:"Rich Text", section:"Text & rich content"){
    body{
        sectionLabel("Typographic structure and inline flavors")
        grid(2, 4,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.75],
            rows-weight:[1.1, 1.2, 0.7, 1.4])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                grid(1, 2, font-size:3%P){
                    "Hello World"
                    text("Hello World")
                    text("Hello World",font-italic)
                    text("Hello World",font-bold)
                }
            }
            miniCodeNTexup("""
                grid(1,2,font-size:3%P){
                  "Hello World"
                  text("Hello World")
                  text("Hello World",font-italic)
                  text("Hello World",font-bold)
                }
            """, fontSize:2.0%P)

            miniPage{
                ntf("""
                    ##:+ Bold X##
                    ##:/ Italic Y##
                    #) Title 1
                    ##) Title 2
                    ###) Title 3
                """, font-size:2.8%P, color:documentTextPrimary)
            }
            miniCodeNTexup(```
                ntf("""
                    ##:+ Bold X##
                    ##:/ Italic Y##
                    #) Title 1
                    ##) Title 2
                    ###) Title 3
                """, font-size:2.8%P,
                  color:documentTextPrimary)
            ```, fontSize:2.0%P)

            miniPage{
                text(
                    "[[ntf: ##:p1: hello##]] world",
                    font-size:3%P,
                    color:documentTextPrimary)
            }
            miniCodeNTexup(```
                text(
                  "[[ntf: ##:p1: hello##]] world",
                  font-size:3%P,
                  color:documentTextPrimary)
            ```, fontSize:2.0%P)

            miniPage{
                text("""
                    #) Equation 1 =
                    [[eq: X²=\sin(πx) ]]
                    ##) Equation 2 =
                    [[eq: X^2=\sin(\pi x) ]]
                    ###) Equation 3 =
                    [[eq: X^2=\sin(x) ]]
                """, font-size:2.4%P, color:documentTextPrimary)
            }
            miniCodeNTexup(```
                text("""
                    #) Equation 1 =
                    [[eq: X²=\sin(πx) ]]
                    ##) Equation 2 =
                    [[eq: X^2=\sin(\pi x) ]]
                    ###) Equation 3 =
                    [[eq: X^2=\sin(x) ]]
                """, font-size:2.4%P,
                  color:documentTextPrimary)
            ```, fontSize:2.0%P)
        }
    }
}

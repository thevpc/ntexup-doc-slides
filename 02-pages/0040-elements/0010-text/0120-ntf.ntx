content-slide(title:"NTF format", section:"Text & rich content"){
    body{
        sectionLabel("Headings, palette colors, and style tokens")
        grid(2, 2,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.6])
        {
            styles{
                "*": {margin:1}
                ntf{ source-primary-color:documentColors }
            }
            miniPage{
                ntf("""
                    #) Heading 1
                    ##) Heading 2
                    ###) Heading 3
                """, font-size:3%P)
            }
            miniCodeNTexup(```
                ntf("""
                    #) Heading 1
                    ##) Heading 2
                    ###) Heading 3
                """, font-size:3%P)
            ```, fontSize:2.1%P)

            miniPage{
                ntf("""
                    ##:p1: Blue##  ##:p2: Violet##
                    ##:p3: Emerald##  ##:p4: Amber##
                    ##:p10: Fuchsia##  ##:/: Italic##
                    ##:info: Info##
                """, font-size:2.8%P)
            }
            miniCodeNTexup(```
                ntf("""
                    ##:p1: Blue##  ##:p2: Violet##
                    ##:p3: Emerald##  ##:p4: Amber##
                    ##:p10: Fuchsia##  ##:/: Italic##
                    ##:info: Info##
                """, font-size:2.8%P)
            ```, fontSize:2.0%P)
        }
    }
}

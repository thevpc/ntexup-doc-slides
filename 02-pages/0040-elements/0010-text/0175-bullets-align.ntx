content-slide(title:"Bullets Alignment", section:"Text & rich content"){
    body{
        sectionLabel("Bullet markers aligned to text or object bounds")
        grid(2, 2,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.2])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                grid(1, 2, rows-weight:[1, 4]){
                    text("bullet-align: top · wrapped text",
                         font-bold, font-size:2.2%P,
                         color:documentTextPrimary)
                    ul(bullet-align:top, font-size:2.4%P){
                        text("""
                            First item wraps onto several lines.
                            Its bullet stays with the first line.
                        """, text-wrap:wrap)
                        text("""
                            Second item also wraps cleanly.
                            Its bullet stays with the first line.
                        """, text-wrap:wrap)
                    }
                }
            }
            miniCodeNTexup(```
                ul(bullet-align:top, font-size:2.4%P){
                    text("""
                        First item wraps onto several lines.
                        Its bullet stays with the first line.
                    """, text-wrap:wrap)
                    text("""
                        Second item also wraps cleanly.
                        Its bullet stays with the first line.
                    """, text-wrap:wrap)
                }
            ```, fontSize:2.2%P)

            miniPage{
                grid(1, 2, rows-weight:[1, 4]){
                    text("bullet-align: center · object bounds",
                         font-bold, font-size:2.2%P,
                         color:documentTextPrimary)
                    ul(bullet-align:center){
                        rectangle(size:(15%P, 4.5%P),
                                  background-color:documentColors[4],
                                  color:documentColors[0])
                        rectangle(size:(15%P, 8.5%P),
                                  background-color:documentColors[4],
                                  color:documentColors[1])
                    }
                }
            }
            miniCodeNTexup("""
                ul(bullet-align:center){
                    rectangle(size:(15%P, 4.5%P),
                              background-color:documentColors[4],
                              color:documentColors[0])
                    rectangle(size:(15%P, 8.5%P),
                              background-color:documentColors[4],
                              color:documentColors[1])
                }
            """, fontSize:2.2%P)
        }
    }
}

content-slide(title:"Bullets Alignment", section:"Text & rich content"){
    body{
        sectionLabel("Bullet markers aligned to text or object bounds")
        grid(2, 2,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.25])
        {
            miniPage{
                grid(1, 2, rows-weight:[1, 4]){
                    text("bullet-align: top · wrapped text",
                         font-bold, font-size:2%P,
                         color:documentTextPrimary)
                    ul(bullet-align:top, font-size:2%P){
                        text("First item wraps cleanly; its marker stays on line one.",
                             text-wrap:wrap)
                        text("Second item wraps too; its marker stays on line one.",
                             text-wrap:wrap)
                    }
                }
            }
            miniCodeNTexup("""
                ul(bullet-align:top, font-size:2%P){
                  text("First item wraps cleanly; its marker stays on line one.",
                    text-wrap:wrap)
                  text("Second item wraps too; its marker stays on line one.",
                    text-wrap:wrap)
                }
            """, fontSize:1.9%P)

            miniPage{
                grid(1, 2, rows-weight:[1, 4]){
                    text("bullet-align: center · object bounds",
                         font-bold, font-size:2%P,
                         color:documentTextPrimary)
                    ul(bullet-align:center, font-size:2%P){
                        rectangle(size:(18%P, 3.5%P),
                                  background-color:documentColors[4])
                        rectangle(size:(18%P, 6.5%P),
                                  background-color:documentColors[3])
                    }
                }
            }
            miniCodeNTexup("""
                ul(bullet-align:center, font-size:2%P){
                  rectangle(size:(18%P, 3.5%P),
                    background-color:documentColors[4])
                  rectangle(size:(18%P, 6.5%P),
                    background-color:documentColors[3])
                }
            """, fontSize:1.9%P)
        }
    }
}

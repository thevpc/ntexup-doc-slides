content-slide(title:"Bullets Alignment",variant:3){
    body{
        grid(2, 2, columns-weight: [1, 1.2]){
            styles:{
                "*": {margin: 2}
                source:{
                    at: left
                }
            }

            // Row 1: bullet-align: top with multi-line text
            miniPage{
                styles:{
                    "*": {font-size: 2.2%P}
                }
                grid(1, 2, rows-weight: [1, 4]){
                    text("bullet-align: top (for multi-line text):", font-bold, color: documentColors[0])
                    ul(bullet-align: top){
                        text("First item with a long multi-line description that wraps onto several lines cleanly. The bullet marker stays aligned with the first line.", text-wrap: wrap)
                        text("Second item also spanning multiple lines cleanly with top-aligned bullet marker.", text-wrap: wrap)
                    }
                }
            }
            miniCodeNTexup(```
                ul(bullet-align: top){
                    text("First item multi-line...",
                         text-wrap: wrap)
                    text("Second item multi-line...",
                         text-wrap: wrap)
                }
            ```)

            // Row 2: bullet-align: center with large objects
            miniPage{
                styles:{
                    "*": {font-size: 2.2%P}
                }
                grid(1, 2, rows-weight: [1, 4]){
                    text("bullet-align: center (for large objects):", font-bold, color: documentColors[1])
                    ul(bullet-align: center){
                        rectangle(size: (15%P, 4.5%P), background: documentColors[4], color: documentColors[0])
                        rectangle(size: (15%P, 8.5%P), background: documentColors[4], color: documentColors[1])
                    }
                }
            }
            miniCodeNTexup(```
                ul(bullet-align: center){
                    rectangle(size: (32%P, 3.5%P),
                              background: documentColors[4],
                              color: documentColors[0])
                    rectangle(size: (32%P, 3.5%P),
                              background: documentColors[4],
                              color: documentColors[1])
                }
            ```)
        }
    }
}

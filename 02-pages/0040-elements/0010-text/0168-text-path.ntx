content-slide(title:"Text along Path", section:"Text & rich content"){
    body{
        sectionLabel("Alignment on curved and segmented paths")
        grid(2, 3,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.25])
        {
            miniPage{
                text("Centered Arc Text",
                     text-path:{arc(cx:50, cy:70, rx:38, ry:22,
                                    from:-20, to:200)},
                     text-align:center, font-bold,
                     font-size:2.5%P, color:documentColors[0])
            }
            miniCodeNTexup("""
                text("Centered Arc Text",
                  text-path:{arc(cx:50, cy:70, rx:38, ry:22,
                    from:-20, to:200)},
                  text-align:center, font-bold,
                  font-size:2.5%P, color:documentColors[0])
            """, fontSize:2.1%P)

            miniPage{
                text("Justify text now",
                     text-path:{arc(cx:50, cy:70, rx:38, ry:22,
                                    from:300, to:240)},
                     text-align:justify, font-bold,
                     font-size:2.1%P, color:documentColors[1])
            }
            miniCodeNTexup("""
                text("Justify text now",
                  text-path:{arc(cx:50, cy:70, rx:38, ry:22,
                    from:300, to:240)},
                  text-align:justify, font-bold,
                  font-size:2.1%P, color:documentColors[1])
            """, fontSize:2.1%P)

            miniPage{
                text("Left path",
                     text-path:{(8,35), (35,70), (65,35), (92,70)},
                     text-align:left, font-size:2.4%P,
                     color:documentColors[2])
                text("Right path",
                     text-path:{(8,55), (35,90), (65,55), (92,90)},
                     text-align:right, font-size:2.4%P,
                     color:documentColors[3])
            }
            miniCodeNTexup("""
                text("Left path",
                  text-path:{(8,35), (35,70), (65,35), (92,70)},
                  text-align:left, font-size:2.4%P,
                  color:documentColors[2])
                text("Right path",
                  text-path:{(8,55), (35,90), (65,55), (92,90)},
                  text-align:right, font-size:2.4%P,
                  color:documentColors[3])
            """, fontSize:1.9%P)
        }
    }
}

content-slide(title:"Text along Path", section:"Text & rich content"){
    body{
        sectionLabel("Alignment on curved and segmented paths")
        grid(2, 3,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.2])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                text("Non-linear Arc Centered Text",
                     text-path:{arc(cx:50, cy:75, rx:42, ry:25,
                                    from:-25, to:205)},
                     text-align:center, font-bold,
                     font-size:2.5%P, color:documentColors[0])
            }
            miniCodeNTexup("""
                text("Non-linear Arc Centered Text",
                     text-path:{arc(cx:50, cy:75, rx:42, ry:25,
                                    from:-25, to:205)},
                     text-align:center, font-bold,
                     font-size:2.5%P, color:documentColors[0])
            """, fontSize:2.2%P)

            miniPage{
                text("Justified Curved Text Along Arc Path",
                     text-path:{arc(cx:50, cy:75, rx:42, ry:25,
                                    from:-25, to:205)},
                     text-align:justify, font-bold,
                     font-size:2.3%P, color:documentColors[1])
            }
            miniCodeNTexup("""
                text("Justified Curved Text Along Arc Path",
                     text-path:{arc(cx:50, cy:75, rx:42, ry:25,
                                    from:-25, to:205)},
                     text-align:justify, font-bold,
                     font-size:2.3%P, color:documentColors[1])
            """, fontSize:2.2%P)

            miniPage{
                text("Left aligned path",
                     text-path:{(5,30), (35,70), (65,30), (95,70)},
                     text-align:left, font-size:2.2%P,
                     color:documentColors[2])
                text("Right aligned path",
                     text-path:{(5,45), (35,85), (65,45), (95,85)},
                     text-align:right, font-size:2.2%P,
                     color:documentColors[3])
            }
            miniCodeNTexup("""
                text("Left aligned path",
                     text-path:{(5,30), (35,70), (65,30), (95,70)},
                     text-align:left, font-size:2.2%P,
                     color:documentColors[2])
                text("Right aligned path",
                     text-path:{(5,45), (35,85), (65,45), (95,85)},
                     text-align:right, font-size:2.2%P,
                     color:documentColors[3])
            """, fontSize:2.2%P)
        }
    }
}

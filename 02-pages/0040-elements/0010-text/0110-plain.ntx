content-slide(title:"Simple Text", section:"Text & rich content"){
    body{
        sectionLabel("plain() · literal text without markup")
        grid(2, 4,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.6])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                plain("Hello World", font-size:6%P)
            }
            miniCodeNTexup("""
                plain("Hello World", font-size:6%P)
            """, fontSize:2.4%P)

            miniPage{
                plain("Hello World", font-italic, font-size:6%P)
            }
            miniCodeNTexup("""
                plain("Hello World",
                      font-italic, font-size:6%P)
            """, fontSize:2.4%P)

            miniPage{
                plain("""
                    Hello
                    World
                """, font-bold, font-size:6%P)
            }
            miniCodeNTexup(```
                plain("""
                    Hello
                    World
                """, font-bold, font-size:6%P)
            ```, fontSize:2.3%P)

            miniPage{
                plain("""
                    Hello  World
                    This    Is    Me
                """, font-family:monospaced, font-size:4%P)
            }
            miniCodeNTexup(```
                plain("""
                    Hello  World
                    This    Is    Me
                """, font-family:monospaced,
                   font-size:4%P)
            ```, fontSize:2.3%P)
        }
    }
}

content-slide(title:"Source Code", section:"Text & rich content"){
    body{
        sectionLabel("Light previews · C++, Scala, and verified language ids")
        grid(2, 4,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.7])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                styles{
                    source{
                        background-color:documentBg
                        color:documentTextPrimary
                        draw-contour:false
                        padding:0
                        source-keyword-color:documentColors[5]
                        source-entity-color:documentColors[0]
                        source-string-color:documentColors[2]
                        source-number-color:documentColors[3]
                        source-operator-color:documentTextSecondary
                        source-comments-color:documentTextMuted
                    }
                }
                source(java
                    """
                        public class MyClass {
                            int add(int b) {
                                return 10 + b;
                            }
                        }
                    """
                    at:top-left, font-size:2%P
                )
            }
            miniCodeNTexup(```
                source(java """
                    public class MyClass {
                        int add(int b) {
                            return 10 + b;
                        }
                    }
                """, at:top-left, font-size:2%P)
            ```, fontSize:1.75%P)

            miniPage{
                styles{
                    source{
                        background-color:documentBg
                        color:documentTextPrimary
                        draw-contour:false
                        padding:0
                        source-keyword-color:documentColors[5]
                        source-entity-color:documentColors[0]
                        source-string-color:documentColors[2]
                        source-number-color:documentColors[3]
                        source-operator-color:documentTextSecondary
                        source-comments-color:documentTextMuted
                    }
                }
                source(cpp
                    """
                        #include <iostream>
                        int main() {
                            std::cout << "Hello C++";
                        }
                    """
                    at:top-left, font-size:2.2%P
                )
            }
            miniCodeNTexup(```
                source(cpp """
                    #include <iostream>
                    int main() {
                        std::cout << "Hello C++";
                    }
                """, at:top-left, font-size:2.2%P)
            ```, fontSize:1.85%P)

            miniPage{
                styles{
                    source{
                        background-color:documentBg
                        color:documentTextPrimary
                        draw-contour:false
                        padding:0
                        source-keyword-color:documentColors[5]
                        source-entity-color:documentColors[0]
                        source-string-color:documentColors[2]
                        source-number-color:documentColors[3]
                        source-operator-color:documentTextSecondary
                        source-comments-color:documentTextMuted
                    }
                }
                source(scala
                    """
                        object Hello {
                            def main(args: Array[String]): Unit =
                                println("Hello Scala")
                        }
                    """
                    at:top-left, font-size:2.1%P
                )
            }
            miniCodeNTexup(```
                source(scala """
                    object Hello {
                        def main(args: Array[String]): Unit =
                            println("Hello Scala")
                    }
                """, at:top-left, font-size:2.1%P)
            ```, fontSize:1.85%P)

            miniPage{
                styles{
                    source{
                        background-color:documentBg
                        color:documentTextPrimary
                        draw-contour:false
                        padding:0
                        source-keyword-color:documentColors[5]
                        source-entity-color:documentColors[0]
                        source-string-color:documentColors[2]
                        source-number-color:documentColors[3]
                        source-operator-color:documentTextSecondary
                        source-comments-color:documentTextMuted
                    }
                }
                source(text
                    """
                        Verified: C++ = cpp, Scala = scala
                        text, plain, java, cpp, csharp, scala
                        python, js, ts, rust, go, kotlin, swift
                        xml, json, sql, yaml, toml, markdown
                        bash, fish, cmd, ntf, tson, ntexup
                    """
                    at:top-left, font-size:1.45%P
                )
            }
            miniCodeNTexup(```
                source(text """
                    Verified: C++ = cpp, Scala = scala
                    text, plain, java, cpp, csharp, scala
                    python, js, ts, rust, go, kotlin, swift
                    xml, json, sql, yaml, toml, markdown
                    bash, fish, cmd, ntf, tson, ntexup
                """, at:top-left, font-size:1.45%P)
            ```, fontSize:1.55%P)
        }
    }
}

content-slide(title:"Source Code", section:"Text & rich content"){
    body{
        sectionLabel("Highlighted, readable, reproducible")
        grid(2, 4,
            position:(0, 8), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.7])
        {
            styles{
                "*": {margin:1}
            }
            miniPage{
                source(java
                    """
                        public class MyClass {
                            int add(int b) {
                                return 10 + b;
                            }
                        }
                    """
                    at:top-left, font-size:2.4%P
                )
            }
            miniCodeNTexup(```
                source(java """
                    public class MyClass {
                        int add(int b) {
                            return 10 + b;
                        }
                    }
                """, at:top-left, font-size:2.4%P)
            ```, fontSize:2.1%P)

            miniPage{
                source(sql
                    """
                        SELECT *
                        FROM Tab
                        WHERE 1 = 1
                    """
                    at:top-left, font-size:2.6%P
                )
            }
            miniCodeNTexup(```
                source(sql """
                    SELECT *
                    FROM Tab
                    WHERE 1 = 1
                """, at:top-left, font-size:2.6%P)
            ```, fontSize:2.2%P)

            miniPage{
                source(xml
                    """
                        <a value="text">
                          <b value="text"></b>
                        </a>
                    """
                    at:top-left, font-size:2.6%P
                )
            }
            miniCodeNTexup(```
                source(xml """
                    <a value="text">
                      <b value="text"></b>
                    </a>
                """, at:top-left, font-size:2.6%P)
            ```, fontSize:2.2%P)

            demoPanel("Verified language ids"){
                source(text
                    """
                        text, plain, java
                        cpp, csharp, xml, html
                        json, sql, bash, fish, cmd
                        ntf, tson, ntexup
                    """
                    at:top-left, font-size:2.4%P
                )
            }
            miniCodeNTexup(```
                source(text """
                    text, plain, java
                    cpp, csharp, xml, html
                    json, sql, bash, fish, cmd
                    ntf, tson, ntexup
                """, at:top-left, font-size:2.4%P)
            ```, fontSize:2.1%P)
        }
    }
}

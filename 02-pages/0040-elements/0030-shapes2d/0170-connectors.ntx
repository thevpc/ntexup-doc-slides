content-slide(title:"Connectors — endpoints", section:"2D graphics"){
    body{
        grid(2, 2, columns-weight:[1, 1], rows-weight:[1, 1]){
            col(rows-weight:[62, 38]){
                demoPanel("Automatic anchors"){
                    rectangle(name:"a1", position:(8, 20), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("API", at:center, font-size:2.6%P, font-bold)
                    }
                    rectangle(name:"b1", position:(64, 56), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("DB", at:center, font-size:2.6%P, font-bold)
                    }
                    connector("a1", "b1", end-arrow:simple(), stroke:2, color:documentColors[0])
                }
                sourcePanel("""
                    connector("a1", "b1",
                        end-arrow: simple(),
                        stroke: 2)
                """, title:"Connector excerpt")
            }
            col(rows-weight:[62, 38]){
                demoPanel("Edge & radial anchors"){
                    rectangle(name:"a2", position:(8, 32), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("API", at:center, font-size:2.6%P, font-bold)
                    }
                    rectangle(name:"b2", position:(64, 32), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("DB", at:center, font-size:2.6%P, font-bold)
                    }
                    connector(from:"a2@right(20)", to:"b2@radial(270)", end-arrow:triangle-full(), stroke:2, color:documentColors[0])
                }
                sourcePanel("""
                    connector(
                        from: "a2@right(20)",
                        to: "b2@radial(270)",
                        end-arrow: triangle-full())
                """, title:"Edge % and radial angle")
            }
            col(rows-weight:[62, 38]){
                demoPanel("Waypoints"){
                    rectangle(name:"a3", position:(8, 18), origin:top-left, size:(30, 24), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("API", at:center, font-size:2.6%P, font-bold)
                    }
                    rectangle(name:"b3", position:(64, 58), origin:top-left, size:(30, 24), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("DB", at:center, font-size:2.6%P, font-bold)
                    }
                    connector("a3", "b3", via:(46, 70), route:"rounded", bend-radius:6, end-arrow:simple(), stroke:2, color:documentColors[0])
                }
                sourcePanel("""
                    connector("a3", "b3",
                        via: (46, 70),
                        route: "rounded",
                        bend-radius: 6)
                """, title:"Rounded waypoint")
            }
            col(rows-weight:[62, 38]){
                demoPanel("Free and mixed points"){
                    rectangle(name:"src4", position:(8, 20), origin:top-left, size:(30, 24), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("SRC", at:center, font-size:2.6%P, font-bold)
                    }
                    connector("src4", (88, 38), end-arrow:simple(), stroke:2, color:documentColors[0])
                    connector((12, 72), (86, 72), start-arrow:simple(), end-arrow:simple(), stroke:2, color:documentColors[1])
                }
                sourcePanel("""
                    connector("src4", (88, 38),
                        end-arrow: simple())
                    connector((12, 72), (86, 72),
                        arrow: simple())
                """, title:"Free coordinates")
            }
        }
    }
}

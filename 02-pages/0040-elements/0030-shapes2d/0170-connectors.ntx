content-slide(title:"Connectors — endpoints",variant:5){
    body{
        // Row 1, left: automatic border clipping
        text("1. Automatic anchors", position:(2,1), origin:top-left, font-size:2.3)
        rectangle(name:"a1", position:(2,10), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("API", at:center) }
        rectangle(name:"b1", position:(28,20), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("DB", at:center) }
        connector("a1", "b1", end-arrow:simple(), stroke:2)
        source(ntexup
            """
            connector(
                "api", "db",
                end-arrow: simple()
            )
            """
            font-size:1.4%P,
            font-family:Monospaced,
            position:(2,38),
            origin:top-left
        )

        // Row 1, right: explicit side anchors
        text("2. Explicit sides", position:(53,1), origin:top-left, font-size:2.3)
        rectangle(name:"a2", position:(53,10), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("API", at:center) }
        rectangle(name:"b2", position:(79,10), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("DB", at:center) }
        connector(from:"a2@right", to:"b2@left", end-arrow:triangle(), stroke:2)
        source(ntexup
            """
            connector(
                from: "api@right", to: "db@left",
                end-arrow: triangle()
            )
            """
            font-size:1.4%P,
            font-family:Monospaced,
            position:(53,38),
            origin:top-left
        )

        // Row 2, left: via points turn the connector into a polyline
        text("3. Via points", position:(2,52), origin:top-left, font-size:2.3)
        rectangle(name:"a3", position:(2,62), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("API", at:center) }
        rectangle(name:"b3", position:(28,76), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("DB", at:center) }
        connector("a3", "b3", via:(24,75), end-arrow:simple(), stroke:2)
        source(ntexup
            """
            connector("api", "db",
                via: (24, 75),
                end-arrow: simple())
            """
            font-size:1.3%P,
            font-family:Monospaced,
            position:(2,90),
            origin:top-left
        )

        // Row 2, right: free points and mixed node/free endpoints
        text("4. Free and mixed points", position:(53,52), origin:top-left, font-size:2.3)
        rectangle(name:"src4", position:(53,62), origin:top-left, size:(16,12), background-color:white, draw-contour){ text("SRC", at:center) }
        connector("src4", (92,72), end-arrow:simple(), stroke:2)
        connector((55,88), (92,88), start-arrow:simple(), end-arrow:simple(), stroke:2)
        source(ntexup
            """
            connector("src", (92, 72),
                end-arrow: simple())
            connector((55, 88), (92, 88),
                end-arrow: simple())
            """
            font-size:1.3%P,
            font-family:Monospaced,
            position:(53,90),
            origin:top-left
        )
    }
}

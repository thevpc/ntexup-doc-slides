content-slide(title:"Connectors — static vs animated", section:"2D graphics"){
    body{
        grid(2, 1, columns-weight:[1, 1]){
            demoPanel("Static · exports use elapsed 0"){
                text("automatic", position:(2, 4), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                rectangle(name:"s1a", position:(20, 10), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("A", at:center, font-size:2%P) }
                rectangle(name:"s1b", position:(68, 16), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("B", at:center, font-size:2%P) }
                connector("s1a", "s1b", end-arrow:simple(), stroke:2, color:documentColors[0])

                text("explicit sides", position:(2, 28), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                rectangle(name:"s2a", position:(20, 34), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("A", at:center, font-size:2%P) }
                rectangle(name:"s2b", position:(68, 34), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("B", at:center, font-size:2%P) }
                connector(from:"s2a@right", to:"s2b@left", end-arrow:triangle-full(), stroke:2, color:documentColors[0])

                text("waypoints", position:(2, 52), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                rectangle(name:"s3a", position:(20, 58), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("A", at:center, font-size:2%P) }
                rectangle(name:"s3b", position:(68, 64), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("B", at:center, font-size:2%P) }
                connector("s3a", "s3b", via:(58, 69), route:"rounded", bend-radius:4, end-arrow:simple(), stroke:2, color:documentColors[0])

                text("free points", position:(2, 76), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                connector((22, 84), (84, 84), end-arrow:simple(), stroke:2, color:documentColors[0])
            }
            demoPanel("Animated · show mode"){
                text("automatic", position:(2, 4), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                rectangle(name:"a1a", position:(20, 10), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("A", at:center, font-size:2%P) }
                rectangle(name:"a1b", position:(68, 16), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("B", at:center, font-size:2%P) }
                connector("a1a", "a1b", end-arrow:simple(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))

                text("explicit sides", position:(2, 28), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                rectangle(name:"a2a", position:(20, 34), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("A", at:center, font-size:2%P) }
                rectangle(name:"a2b", position:(68, 34), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("B", at:center, font-size:2%P) }
                connector(from:"a2a@right", to:"a2b@left", end-arrow:triangle-full(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))

                text("waypoints", position:(2, 52), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                rectangle(name:"a3a", position:(20, 58), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("A", at:center, font-size:2%P) }
                rectangle(name:"a3b", position:(68, 64), origin:top-left, size:(18, 10), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:3){ text("B", at:center, font-size:2%P) }
                connector("a3a", "a3b", via:(58, 69), route:"rounded", bend-radius:4, end-arrow:simple(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))

                text("free points", position:(2, 76), origin:top-left, font-size:1.8%P, color:documentTextSecondary)
                connector((22, 84), (84, 84), end-arrow:simple(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))
            }
        }
    }
}

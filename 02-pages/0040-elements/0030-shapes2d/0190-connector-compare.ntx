content-slide(title:"Connectors — static vs animated",variant:5){
    body{
        text("static", position:(9,0), origin:top-left, font-size:2.2, font-bold)
        text("animated", position:(56,0), origin:top-left, font-size:2.2, font-bold)

        // Row 1: automatic anchors
        text("auto", position:(0,9), origin:top-left, font-size:1.8)
        rectangle(name:"s1a", position:(9,8), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("A", at:center) }
        rectangle(name:"s1b", position:(27,14), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("B", at:center) }
        connector("s1a", "s1b", end-arrow:simple(), stroke:2)
        rectangle(name:"a1a", position:(56,8), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("A", at:center) }
        rectangle(name:"a1b", position:(74,14), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("B", at:center) }
        connector("a1a", "a1b", end-arrow:simple(), stroke:2, flow:dots(count:3,size:1.2,period:3))

        // Row 2: explicit sides
        text("sides", position:(0,31), origin:top-left, font-size:1.8)
        rectangle(name:"s2a", position:(9,30), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("A", at:center) }
        rectangle(name:"s2b", position:(27,30), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("B", at:center) }
        connector(from:"s2a@right", to:"s2b@left", end-arrow:triangle(), stroke:2)
        rectangle(name:"a2a", position:(56,30), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("A", at:center) }
        rectangle(name:"a2b", position:(74,30), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("B", at:center) }
        connector(from:"a2a@right", to:"a2b@left", end-arrow:triangle(), stroke:2, flow:dots(count:3,size:1.2,period:3))

        // Row 3: via points
        text("via", position:(0,53), origin:top-left, font-size:1.8)
        rectangle(name:"s3a", position:(9,52), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("A", at:center) }
        rectangle(name:"s3b", position:(27,58), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("B", at:center) }
        connector("s3a", "s3b", via:(24,59), end-arrow:simple(), stroke:2)
        rectangle(name:"a3a", position:(56,52), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("A", at:center) }
        rectangle(name:"a3b", position:(74,58), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("B", at:center) }
        connector("a3a", "a3b", via:(71,59), end-arrow:simple(), stroke:2, flow:dots(count:3,size:1.2,period:3))

        // Row 4: free and mixed points
        text("free", position:(0,75), origin:top-left, font-size:1.8)
        rectangle(name:"s4src", position:(9,74), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("SRC", at:center) }
        connector("s4src", (38,78), end-arrow:simple(), stroke:2)
        connector((10,84), (38,84), end-arrow:simple(), stroke:2)
        rectangle(name:"a4src", position:(56,74), origin:top-left, size:(12,8), background-color:white, draw-contour){ text("SRC", at:center) }
        connector("a4src", (85,78), end-arrow:simple(), stroke:2, flow:dots(count:2,size:1.2,period:2))
        connector((57,84), (85,84), end-arrow:simple(), stroke:2, flow:dots(count:3,size:1.2,period:3))

        text("Static export uses elapsed 0; show mode animates the flow dots.", position:(9,94), origin:top-left, font-size:1.8)
    }
}

content-slide(title:"Lines and polylines — flow", section:"2D graphics"){
    body{
        sectionLabel("2D graphics · static and animated flow")
        grid(4, 2,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2, 1, 2])
        {
            demoPanel("line — static"){
                line(from:(10,50), to:(90,50),
                    start-arrow:simple(), end-arrow:triangle(),
                    stroke:2, color:documentColors[1])
            }
            sourcePanel("""
                line(from:(10,50), to:(90,50),
                  start-arrow:simple(), end-arrow:triangle(),
                  stroke:2, color:documentColors[1])
            """, fontSize:2.1%P)

            demoPanel("line — animated"){
                line(from:(10,50), to:(90,50),
                    start-arrow:simple(), end-arrow:triangle(),
                    stroke:2, color:documentColors[1],
                    flow:dots(count:4, size:1.2, period:3))
            }
            sourcePanel("""
                line(from:(10,50), to:(90,50),
                  start-arrow:simple(), end-arrow:triangle(),
                  stroke:2, color:documentColors[1],
                  flow:dots(count:4, size:1.2, period:3))
            """, fontSize:2.1%P)

            demoPanel("polyline — static"){
                polyline(points:((230,1160),(290,1220),
                    (350,1280),(410,1200)),
                    start-arrow:simple(), end-arrow:triangle(),
                    stroke:2, color:documentColors[1])
            }
            sourcePanel("""
                polyline(points:((230,1160),(290,1220),
                  (350,1280),(410,1200)),
                  start-arrow:simple(), end-arrow:triangle(),
                  stroke:2, color:documentColors[1])
            """, fontSize:2.1%P)

            demoPanel("polyline — animated"){
                polyline(points:((1240,1160),(1300,1220),
                    (1360,1280),(1420,1200)),
                    start-arrow:simple(), end-arrow:triangle(),
                    stroke:2, color:documentColors[1],
                    flow:dots(count:4, size:1.2, period:3))
            }
            sourcePanel("""
                polyline(points:((1240,1160),(1300,1220),
                  (1360,1280),(1420,1200)),
                  start-arrow:simple(), end-arrow:triangle(),
                  stroke:2, color:documentColors[1],
                  flow:dots(count:4, size:1.2, period:3))
            """, fontSize:2.1%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Line endpoints are percentages; polyline points are page pixels; stills show spaced dots.")
        }
    }
}

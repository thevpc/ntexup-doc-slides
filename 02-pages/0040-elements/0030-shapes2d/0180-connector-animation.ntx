content-slide(title:"Connectors — animated flow", section:"2D graphics"){
    body{
        grid(2, 2, columns-weight:[1, 1], rows-weight:[1, 1]){
            col(rows-weight:[62, 38]){
                demoPanel("Flow on automatic anchors"){
                    rectangle(name:"fa1", position:(8, 20), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("API", at:center, font-size:2.6%P, font-bold)
                    }
                    rectangle(name:"fb1", position:(64, 56), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("DB", at:center, font-size:2.6%P, font-bold)
                    }
                    connector("fa1", "fb1", end-arrow:simple(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))
                }
                sourcePanel("""
                    connector("fa1", "fb1",
                        end-arrow: simple(),
                        flow: dots(count: 3,
                            size: 1.2, period: 3))
                """, title:"Animated connector")
            }
            col(rows-weight:[62, 38]){
                demoPanel("Flow between sides"){
                    rectangle(name:"fa2", position:(8, 32), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("API", at:center, font-size:2.6%P, font-bold)
                    }
                    rectangle(name:"fb2", position:(64, 32), origin:top-left, size:(30, 26), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("DB", at:center, font-size:2.6%P, font-bold)
                    }
                    connector(from:"fa2@right", to:"fb2@left", end-arrow:triangle-full(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))
                }
                sourcePanel("""
                    connector(
                        from: "fa2@right",
                        to: "fb2@left",
                        flow: dots(count: 3,
                            size: 1.2, period: 3))
                """, title:"Animated connector")
            }
            col(rows-weight:[62, 38]){
                demoPanel("Flow through rounded bends"){
                    rectangle(name:"fa3", position:(8, 18), origin:top-left, size:(30, 24), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("API", at:center, font-size:2.6%P, font-bold)
                    }
                    rectangle(name:"fb3", position:(64, 58), origin:top-left, size:(30, 24), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("DB", at:center, font-size:2.6%P, font-bold)
                    }
                    connector("fa3", "fb3", via:((46, 30), (46, 70)), route:"rounded", bend-radius:6, end-arrow:simple(), stroke:2, color:documentColors[0], flow:dots(count:3, size:1.2, period:3))
                }
                sourcePanel("""
                    connector("fa3", "fb3",
                        via: ((46, 30), (46, 70)),
                        route: "rounded",
                        flow: dots(count: 3))
                """, title:"Flow follows geometry")
            }
            col(rows-weight:[62, 38]){
                demoPanel("Flow on free and mixed points"){
                    rectangle(name:"fsrc4", position:(8, 20), origin:top-left, size:(30, 24), background-color:documentSurface, draw-contour, line-color:documentLine, round-corner:4){
                        text("SRC", at:center, font-size:2.6%P, font-bold)
                    }
                    connector("fsrc4", (88, 38), end-arrow:simple(), stroke:2, color:documentColors[0], flow:dots(count:2, size:1.2, period:2))
                    connector((12, 72), (86, 72), arrow:simple(), stroke:2, color:documentColors[1], flow:dots(count:3, size:1.2, period:3))
                }
                sourcePanel("""
                    connector("fsrc4", (88, 38),
                        flow: dots(count: 2))
                    connector((12, 72), (86, 72),
                        flow: dots(count: 3))
                """, title:"Animated connectors")
            }
        }
    }
}

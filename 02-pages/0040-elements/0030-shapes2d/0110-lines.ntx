content-slide(title:"Lines", section:"2D graphics"){
    body{
        sectionLabel("2D graphics · lines, arcs and curves")
        grid(2, 4,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.8])
        {
            demoPanel("Straight line"){
                line(from:(8,8), to:(92,92),
                    color:documentColors[1], stroke:4)
            }
            sourcePanel("""
                line(from:(8,8), to:(92,92),
                  color:documentColors[1], stroke:4)
            """, title:"", fontSize:2.1%P)

            demoPanel("Arc"){
                arc(from:20, to:200,
                    color:documentColors[1], stroke:4)
            }
            sourcePanel("""
                arc(from:20, to:200,
                  color:documentColors[1], stroke:4)
            """, title:"", fontSize:2.1%P)

            demoPanel("Quadratic curve"){
                quad-curve(from:(8,8), to:(92,92),
                    ctrl:(65,25),
                    color:documentColors[1], stroke:4)
            }
            sourcePanel("""
                quad-curve(from:(8,8), to:(92,92),
                  ctrl:(65,25),
                  color:documentColors[1], stroke:4)
            """, title:"", fontSize:2.1%P)

            demoPanel("Cubic curve"){
                cubic-curve(from:(8,8), to:(92,92),
                    ctrl1:(65,25), ctrl2:(25,65),
                    color:documentColors[1], stroke:4)
            }
            sourcePanel("""
                cubic-curve(from:(8,8), to:(92,92),
                  ctrl1:(65,25), ctrl2:(25,65),
                  color:documentColors[1], stroke:4)
            """, title:"", fontSize:2.1%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Line and curve endpoints are parent-relative; arc from/to values are angles in degrees.")
        }
    }
}

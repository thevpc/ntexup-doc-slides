content-slide(title:"Other Shapes", section:"2D graphics"){
    body{
        sectionLabel("2D graphics · arrows and pseudo-3D solids")
        grid(2, 4,
            position:(0, 6), size:(100, 88), origin:top-left,
            columns-weight:[1, 2.4])
        {
            demoPanel("Directional arrow"){
                arrow(at:center, size:(55,65),
                    color:documentColors[2], rotate:-45)
            }
            sourcePanel("""
                arrow(at:center, size:(55,65),
                  color:documentColors[2], rotate:-45)
            """, title:"", fontSize:1.9%P)

            demoPanel("Cylinder segments"){
                styles{
                    cylinder{
                        size:(40,45), stroke:1.2, ellipse-height:25
                    }
                }
                cylinder(origin:center, position:(50,30),
                    segment-count:5,
                    background-color:documentColors[0])
                cylinder(origin:center, position:(50,75),
                    segment-count:3,
                    background-color:documentColors[3])
            }
            sourcePanel("""
                styles{cylinder{size:(40,45),stroke:1.2,ellipse-height:25}}
                cylinder(origin:center, position:(50,30),segment-count:5,
                  background-color:documentColors[0])
                cylinder(origin:center, position:(50,75),segment-count:3,
                  background-color:documentColors[3])
            """, title:"", fontSize:1.6%P)

            demoPanel("Donut radii and angles"){
                styles{
                    donut{size:42, stroke:2}
                }
                donut(origin:center, position:(50,30),
                    inner-radius:50, extent-angle:270,
                    background-color:documentColors[0])
                donut(origin:center, position:(50,75),
                    inner-radius:30,
                    background-color:documentColors[3])
            }
            sourcePanel("""
                styles{donut{size:42,stroke:2}}
                donut(origin:center, position:(50,30),inner-radius:50,extent-angle:270,
                  background-color:documentColors[0])
                donut(origin:center, position:(50,75),inner-radius:30,
                  background-color:documentColors[3])
            """, title:"", fontSize:1.7%P)

            demoPanel("Pie extents"){
                styles{
                    pie{size:42, stroke:2}
                }
                pie(origin:center, position:(50,30),
                    extent-angle:270,
                    background-color:documentColors[0])
                pie(origin:center, position:(50,75),
                    background-color:documentColors[3])
            }
            sourcePanel("""
                styles{pie{size:42,stroke:2}}
                pie(origin:center, position:(50,30),extent-angle:270,
                  background-color:documentColors[0])
                pie(origin:center, position:(50,75),
                  background-color:documentColors[3])
            """, title:"", fontSize:1.7%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Solids use background-color; thin cylinder strokes keep the small caps and segments crisp.")
        }
    }
}

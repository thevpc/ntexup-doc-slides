content-slide(title:"Other Shapes", section:"2D graphics"){
    body{
        sectionLabel("2D graphics · arrows and pseudo-3D solids")
        grid(4, 2,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            demoPanel("Directional arrow"){
                arrow(at:center, color:documentColors[2],
                    rotate:-45)
            }
            sourcePanel("""
                arrow(at:center,
                  color:documentColors[2], rotate:-45)
            """, fontSize:2.1%P)

            demoPanel("Cylinder segments"){
                cylinder(origin:center, position:(50,20),
                    size:(30,25), stroke:5, ellipse-height:20,
                    segment-count:5,
                    background-color:documentColors[0])
                cylinder(origin:center, position:(50,50),
                    size:(30,25), stroke:5, ellipse-height:20,
                    segment-count:3,
                    background-color:documentColors[3])
                cylinder(origin:center, position:(50,80),
                    size:(30,25), stroke:5, ellipse-height:20,
                    background-color:documentColors[4])
            }
            sourcePanel("""
                cylinder(origin:center, position:(50,20),
                  size:(30,25), stroke:5, ellipse-height:20,
                  segment-count:5,
                  background-color:documentColors[0])
                cylinder(origin:center, position:(50,50),
                  size:(30,25), stroke:5, ellipse-height:20,
                  segment-count:3,
                  background-color:documentColors[3])
                cylinder(origin:center, position:(50,80),
                  size:(30,25), stroke:5, ellipse-height:20,
                  background-color:documentColors[4])
            """, fontSize:2.1%P)

            demoPanel("Donut radii and angles"){
                donut(origin:center, position:(50,15),
                    size:40, stroke:5,
                    background-color:documentColors[0],
                    inner-radius:50, start-angle:0,
                    extent-angle:270)
                donut(origin:center, position:(50,45),
                    size:40, stroke:5,
                    background-color:documentColors[3],
                    inner-radius:30)
                donut(origin:center, position:(50,75),
                    size:40, stroke:5,
                    background-color:documentColors[4],
                    inner-radius:80)
            }
            sourcePanel("""
                donut(origin:center, position:(50,15),
                  size:40, stroke:5,
                  background-color:documentColors[0],
                  inner-radius:50, start-angle:0,
                  extent-angle:270)
                donut(origin:center, position:(50,45),
                  size:40, stroke:5,
                  background-color:documentColors[3],
                  inner-radius:30)
                donut(origin:center, position:(50,75),
                  size:40, stroke:5,
                  background-color:documentColors[4],
                  inner-radius:80)
            """, fontSize:2.1%P)

            demoPanel("Pie extents"){
                pie(origin:center, position:(50,30),
                    size:40, stroke:5,
                    background-color:documentColors[0],
                    start-angle:0, extent-angle:270)
                pie(origin:center, position:(50,75),
                    size:40, stroke:5,
                    background-color:documentColors[3])
            }
            sourcePanel("""
                pie(origin:center, position:(50,30),
                  size:40, stroke:5,
                  background-color:documentColors[0],
                  start-angle:0, extent-angle:270)
                pie(origin:center, position:(50,75),
                  size:40, stroke:5,
                  background-color:documentColors[3])
            """, fontSize:2.1%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("These solids use background-color; start-angle and extent-angle are expressed in degrees.")
        }
    }
}

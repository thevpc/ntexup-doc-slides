                          background-color:documentColors[4])
                    """, fontSize:1.7%P)
                }
            }
            group(margin:2){
                grid(1, 2){
                    miniPage{
                        polygon(at:center, size:(80,80),
                          preserve-aspect-ratio, count:8,
                            background-color:documentColors[4])
                    }
                    miniCodeNTexup("""

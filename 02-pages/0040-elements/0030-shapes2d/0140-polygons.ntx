                    """, fontSize:1.7%P)
                }
            }
            group(margin:2){
                grid(1, 2){
                    miniPage{
                        nonagon(at:center, size:(80,80),
                          preserve-aspect-ratio,
                            background-color:documentColors[4])
                    }
                    miniCodeNTexup("""
                        nonagon(at:center, size:(80,80),
                          preserve-aspect-ratio,
                          background-color:documentColors[4])
                    """, fontSize:1.7%P)
                }
            }
            group(margin:2){
                grid(1, 2){

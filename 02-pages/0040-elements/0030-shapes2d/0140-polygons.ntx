content-slide(title:"Polygons", section:"2D graphics"){
    body{
        sectionLabel("2D graphics · regular and custom polygons")
        grid(3, 3,
            position:(0, 7), size:(100, 88), origin:top-left)
        {
            group(margin:2){
                grid(1, 2){
                    miniPage{
                        pentagon(at:center, size:(80,80),
                          preserve-aspect-ratio,
                            background-color:documentColors[4])
                    }
                    miniCodeNTexup("""
                        pentagon(at:center, size:(80,80),
                          preserve-aspect-ratio,
                          background-color:documentColors[4])
                    """, fontSize:1.7%P)
                }
            }
            group(margin:2){
                grid(1, 2){
                    miniPage{
                        hexagon(at:center, size:(80,80),
                          preserve-aspect-ratio,
                            background-color:documentColors[4])

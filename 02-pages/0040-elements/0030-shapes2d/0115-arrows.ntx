content-slide(title:"Arrows", section:"2D graphics"){
    body{
        sectionLabel("2D graphics · start and end arrowheads")
        grid(2, 5,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            miniPage{
                line(from:(10,10), to:(80,90),
                    end-arrow:simple(),
                    color:documentColors[1], stroke:3)
            }
            miniCodeNTexup("""
                line(from:(10,10), to:(80,90),
                  end-arrow:simple(),
                  color:documentColors[1], stroke:3)
            """)

            miniPage{
                line(from:(10,10), to:(80,90),
                    start-arrow:triangle(),
                    end-arrow:triangle-full(),
                    color:documentColors[1], stroke:3)
            }
            miniCodeNTexup("""
                line(from:(10,10), to:(80,90),
                  start-arrow:triangle(),
                  end-arrow:triangle-full(),
                  color:documentColors[1], stroke:3)
            """)

            miniPage{
                line(from:(10,10), to:(80,90),
                    start-arrow:oval(),
                    end-arrow:oval-full(),
                    color:documentColors[1], stroke:3)
            }
            miniCodeNTexup("""
                line(from:(10,10), to:(80,90),
                  start-arrow:oval(),
                  end-arrow:oval-full(),
                  color:documentColors[1], stroke:3)
            """)

            miniPage{
                line(from:(10,10), to:(80,90),
                    start-arrow:diamond(),
                    end-arrow:diamond-full(),
                    color:documentColors[1], stroke:3)
            }
            miniCodeNTexup("""
                line(from:(10,10), to:(80,90),
                  start-arrow:diamond(),
                  end-arrow:diamond-full(),
                  color:documentColors[1], stroke:3)
            """)

            miniPage{
                line(from:(10,10), to:(80,90),
                    start-arrow:rectangle(),
                    end-arrow:rectangle-full(),
                    color:documentColors[1], stroke:3)
            }
            miniCodeNTexup("""
                line(from:(10,10), to:(80,90),
                  start-arrow:rectangle(),
                  end-arrow:rectangle-full(),
                  color:documentColors[1], stroke:3)
            """)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Arrowheads use function-call names; open and filled variants can be mixed at either end.")
        }
    }
}

content-slide(title: "Gantt Diagrams — Dependencies & Color") {
    body {
        col(rows-weight: [6, 86, 8]) {
            sectionLabel("Diagrams")
            grid((2, 2), columns-weight: [1.45, 1]) {
                demoPanel("Task dependencies and milestones") {
                    gantt(
                        size: (100, 78),
                        at: center,
                        """
                        [Task1] requires 4 days
                        then [Task1.1] requires 4 days
                        [Task1.2] starts at [Task1]'s end and requires 7 days

                        [Task2] requires 5 days
                        then [Task2.1] requires 4 days

                        [MaxTaskEnd] happens at [Task1.1]'s end
                        [MaxTaskEnd] happens at [Task1.2]'s end
                        [MaxTaskEnd] happens at [Task2.1]'s end
                        """
                    )
                }
                sourcePanel(
                    '''gantt(size:(100,78), at:center,
"""
[Task1] requires 4 days
then [Task1.1] requires 4 days
[Task1.2] starts at [Task1]'s end and requires 7 days

[Task2] requires 5 days
then [Task2.1] requires 4 days

[MaxTaskEnd] happens at [Task1.1]'s end
[MaxTaskEnd] happens at [Task1.2]'s end
[MaxTaskEnd] happens at [Task2.1]'s end
""")''',
                    title: "Dependencies + milestones · complete example",
                    fontSize: 1.6%P
                )

                demoPanel("Sequential tasks with explicit colors") {
                    gantt(
                        size: (100, 62),
                        at: center,
                        """
                        [Prototype design] requires 13 days
                        [Test prototype] requires 4 days
                        [Test prototype] starts at [Prototype design]'s end
                        [Prototype design] is colored in Fuchsia/FireBrick
                        [Test prototype] is colored in GreenYellow/Green
                        """
                    )
                }
                sourcePanel(
                    '''gantt(size:(100,62), at:center,
"""
[Prototype design] requires 13 days
[Test prototype] requires 4 days
[Test prototype] starts at [Prototype design]'s end
[Prototype design] is colored in Fuchsia/FireBrick
[Test prototype] is colored in GreenYellow/Green
""")''',
                    title: "Placement + colors · complete example",
                    fontSize: 1.8%P
                )
            }
            pageNote("size and at place each chart; milestone lines make the shared completion dependency explicit.")
        }
    }
}

content-slide(title: "UML Class Diagrams") {
    body {
        col(rows-weight: [6, 86, 8]) {
            sectionLabel("Diagrams")
            grid((2, 2), columns-weight: [1, 1.55]) {
                demoPanel("Inheritance and interface realization") {
                    uml(
                        at: center,
                        size: (100, 50),
                        """
                        Object <|-- ArrayList
                        List <|.. ArrayList
                        interface List
                        Object : equals()
                        ArrayList : Object[] elementData
                        ArrayList : size()
                        """
                    )
                }
                sourcePanel(
                    ```
uml(at:center, size:(100,50),
"""
Object <|-- ArrayList
List <|.. ArrayList
interface List
Object : equals()
ArrayList : Object[] elementData
ArrayList : size()
""")
```,
                    title: "Class diagram · complete example",
                    fontSize: 2.1%P
                )

                demoPanel("Repository injection and composition") {
                    uml(
                        at: center,
                        size: (100, 50),
                        """
                        interface Repository
                        class UserService {
                          -repository : Repository
                          +findUser(id : Long) : User
                        }
                        class DatabaseRepository
                        class User
                        Repository <|.. DatabaseRepository
                        UserService o-- Repository
                        UserService --> User
                        """
                    )
                }
                sourcePanel(
                    ```
uml(at:center, size:(100,50),
"""
interface Repository
class UserService {
  -repository : Repository
  +findUser(id : Long) : User
}
class DatabaseRepository
class User
Repository <|.. DatabaseRepository
UserService o-- Repository
UserService --> User
""")
```,
                    title: "Class diagram · fields and operations",
                    fontSize: 2.1%P
                )
            }
            pageNote("<|-- inheritance; <|.. realization; o-- composition. Members show visibility, name, and type.")
        }
    }
}

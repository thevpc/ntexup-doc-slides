content-slide(title: "UML Use Cases") {
    body {
        col(rows-weight: [6, 88, 6]) {
            sectionLabel("Diagrams")
            grid((2, 2), columns-weight: [1, 1.55]) {
                demoPanel("Restaurant actors and goals") {
                    uml(
                        at: center,
                        size: (100, 50),
                        """
                        left to right direction
                        actor "Food Critic" as fc
                        rectangle Restaurant {
                          usecase "Eat Food" as UC1
                          usecase "Pay for Food" as UC2
                          usecase "Drink" as UC3
                        }
                        fc --> UC1
                        fc --> UC2
                        fc --> UC3
                        """
                    )
                }
                sourcePanel(
                    ```
uml(at:center, size:(100,50),
"""
left to right direction
actor "Food Critic" as fc
rectangle Restaurant {
  usecase "Eat Food" as UC1
  usecase "Pay for Food" as UC2
  usecase "Drink" as UC3
}
fc --> UC1
fc --> UC2
fc --> UC3
""")
```,
                    title: "Use-case diagram · complete example",
                    fontSize: 2.1%P
                )

                demoPanel("Checkout with included payment") {
                    uml(
                        at: center,
                        size: (100, 50),
                        """
                        left to right direction
                        actor "Customer" as customer
                        actor "Payment Service" as payment
                        rectangle "Online Store" {
                          usecase "Browse Catalog" as browse
                          usecase "Place Order" as order
                          usecase "Pay" as pay
                        }
                        customer --> browse
                        customer --> order
                        order .> pay : <<include>>
                        payment --> pay
                        """
                    )
                }
                sourcePanel(
                    ```
uml(at:center, size:(100,50),
"""
left to right direction
actor "Customer" as customer
actor "Payment Service" as payment
rectangle "Online Store" {
  usecase "Browse Catalog" as browse
  usecase "Place Order" as order
  usecase "Pay" as pay
}
customer --> browse
customer --> order
order .> pay : <<include>>
payment --> pay
""")
```,
                    title: "Use-case diagram · include relationship",
                    fontSize: 1.5%P
                )
            }
            pageNote("Actors sit outside the boundary; <<include>> adds mandatory Pay behavior to Place Order.")
        }
    }
}

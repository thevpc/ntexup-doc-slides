content-slide(title: "3D Primitives — Pyramid & Helix") {
    body {
        col(rows-weight: [6, 88, 6]) {
            sectionLabel("3D graphics")
            grid((2, 2), columns-weight: [1, 1.55]) {
                demoPanel("Pyramid · base and faces") {
                    scene3d(
                        draw-contour,
                        real-position: (-22.5, -20, -17.5),
                        real-size: (45, 40, 35),
                        transform: {
                            rotate(to: (0, 100, 0), angle: 35)
                            scale: 0.75
                        }
                    ) {
                        pyramid(
                            position: (-22.5, -20, -17.5),
                            size: (45, 40, 35),
                            background-color: documentColors[7],
                            faces: {
                                front: { background-color: documentColors[4] }
                                right: { background-color: documentColors[1] }
                                left: { background-color: documentColors[0] }
                            }
                        )
                    }
                }
                sourcePanel(
                    """
scene3d(draw-contour,
  real-position:(-22.5,-20,-17.5),
  real-size:(45,40,35),
  transform:{rotate(to:(0,100,0), angle:35)
            scale:0.75}){
  pyramid(position:(-22.5,-20,-17.5),
    size:(45,40,35),
    background-color:documentColors[7],
    faces:{front:{background-color:documentColors[4]}
           right:{background-color:documentColors[1]}
           left:{background-color:documentColors[0]}})
}
""",
                    title: "Pyramid · complete example",
                    fontSize: 2.1%P
                )

                demoPanel("Helix · turns and stroke") {
                    scene3d(
                        draw-contour,
                        real-position: (-20, -22, -20),
                        real-size: (40, 45, 40),
                        transform: {
                            rotate(to: (0, 100, 0), angle: 25)
                            scale: 0.75
                        }
                    ) {
                        helix(
                            position: (0, -22, 0),
                            radius: (20, 20, 20),
                            height: 45,
                            turns: 3.5,
                            line-color: documentColors[0],
                            stroke: basic(width: 2)
                        )
                    }
                }
                sourcePanel(
                    """
scene3d(draw-contour,
  real-position:(-20,-22,-20),
  real-size:(40,45,40),
  transform:{rotate(to:(0,100,0), angle:25)
            scale:0.75}){
  helix(position:(0,-22,0),
    radius:(20,20,20),
    height:45, turns:3.5,
    line-color:documentColors[0],
    stroke:basic(width:2))
}
""",
                    title: "Helix · complete example",
                    fontSize: 2.1%P
                )
            }
            pageNote("Pyramid base color fills unassigned faces; helix height, turns, and stroke control the curve.")
        }
    }
}

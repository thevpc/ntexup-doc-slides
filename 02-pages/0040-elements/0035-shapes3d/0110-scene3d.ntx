content-slide(title: "3D Primitives — Solids") {
    body {
        col(rows-weight: [6, 88, 6]) {
            sectionLabel("3D graphics")
            grid((2, 2), columns-weight: [1, 1.55]) {
                demoPanel("Box · per-face colors") {
                    scene3d(
                        draw-contour,
                        real-position: (-22.5, -17.5, -12.5),
                        real-size: (45, 35, 25),
                        transform: {
                            rotate(to: (0, 100, 0), angle: 35)
                            scale: 0.75
                        }
                    ) {
                        box(
                            position: (-22.5, -17.5, -12.5),
                            size: (45, 35, 25),
                            background-color: documentColors[3],
                            faces: {
                                top: { background-color: documentColors[0] }
                                front: { background-color: documentColors[4] }
                                right: { background-color: documentColors[1] }
                            }
                        )
                    }
                }
                sourcePanel(
                    """
scene3d(draw-contour,
  real-position:(-22.5,-17.5,-12.5),
  real-size:(45,35,25),
  transform:{rotate(to:(0,100,0), angle:35)
            scale:0.75}){
  box(position:(-22.5,-17.5,-12.5),
    size:(45,35,25),
    background-color:documentColors[3],
    faces:{top:{background-color:documentColors[0]}
           front:{background-color:documentColors[4]}
           right:{background-color:documentColors[1]}})
}
""",
                    title: "Box · complete example",
                    fontSize: 2.1%P
                )

                demoPanel("UV sphere · tessellation") {
                    scene3d(
                        draw-contour,
                        real-position: (-28, -28, -28),
                        real-size: (56, 56, 56),
                        transform: { scale: 0.75 }
                    ) {
                        sphere(
                            radius: (28, 28, 28),
                            meridians: 24,
                            parallels: 16,
                            background-color: documentColors[2],
                            contour-color: lighterColor(documentColors[2], 0.05)
                        )
                    }
                }
                sourcePanel(
                    """
scene3d(draw-contour,
  real-position:(-28,-28,-28),
  real-size:(56,56,56),
  transform:{scale:0.75}){
  sphere(radius:(28,28,28),
    meridians:24, parallels:16,
    background-color:documentColors[2],
    contour-color:lighterColor(
      documentColors[2],0.05))
}
""",
                    title: "Sphere · complete example",
                    fontSize: 2.1%P
                )
            }
            pageNote("Contours reveal mesh edges; meridians and parallels control sphere tessellation.")
        }
    }
}

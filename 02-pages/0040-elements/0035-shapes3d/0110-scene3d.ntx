content-slide(title:"3D Primitives",variant:4){
    body{
        grid(2,2,columns-weight:[1,1.8]){
            styles:{
                "*": {margin:2}
                source:{
                    at:left
                }
            }

            // Row 1: 3D Box with Colored Faces
            miniPage{
                scene3d(
                    draw-contour,
                    real-position:(-22.5,-17.5,-12.5),
                    real-size:(45,35,25),
                    transform:{
                        rotate(to:(0,100,0), angle:35)
                        scale:0.75
                    }
                ){
                    box(position:(-22.5,-17.5,-12.5),
                        size:(45,35,25),
                        background-color:documentColors[3],
                        faces:{
                            top:{background-color:documentColors[0]}
                            front:{background-color:documentColors[4]}
                            right:{background-color:documentColors[1]}
                        }
                    )
                }
            }
            miniCodeNTexup(
            """
            scene3d(real-position:(-22.5,-17.5,-12.5), real-size:(45,35,25)
              , transform:{
                rotate(to:(0,100,0), angle:35)
                scale:0.75
            }){
              box(position:(-22.5,-17.5,-12.5),
                size:(45,35,25),
                faces:{
                  top:{background-color:documentColors[0]}
                  front:{background-color:documentColors[4]}
                  right:{background-color:documentColors[1]}
                }
              )
            }
            """
            )

            // Row 2: UV Sphere
            miniPage{
                scene3d(
                    draw-contour,
                    real-position:(-28,-28,-28),
                    real-size:(56,56,56),
                    transform:{
                        scale:0.75
                    }
                ){
                    sphere(radius:(28,28,28),
                        meridians:24, parallels:16,
                        background-color:documentColors[2],
                        contour-color:lighterColor(documentColors[2],0.05)
                    )
                }
            }
            miniCodeNTexup(
            """
            scene3d(real-position:(-28,-28,-28), real-size:(56,56,56),
              transform:{scale:0.75}){
                sphere(
                    radius:(28,28,28),
                    meridians:24,
                    parallels:16,
                    background-color: documentColors[2]
                    contour-color:lighterColor(documentColors[2],0.05)
              )
            }
            """
            )

        }
    }
}

content-slide(title: "Callout & Academic Components"){
    body{
        col(rows-weight: [6, 86, 8]){
            sectionLabel("Components")

            grid((3, 1), columns-weight: [1, 1, 1]){
                styles{
                    "*": { margin: 1.5 }
                }

                col(rows-weight: [14, 86]){
                    group(margin: 2){
                        divider(width: 80, thickness: 0.4)
                    }
                    callout(title: "Custom Callout",
                            accentColor: documentColors[1],
                            bgColor: documentSurfaceAlt){
                        text("Compose semantic emphasis with custom colors.")
                    }
                }

                col(rows-weight: [1, 1]){
                    definition("Definition"){
                        text("States a precise term or concept.")
                    }
                    theorem("Theorem"){
                        text("Highlights a formal result or proposition.")
                    }
                }

                col(rows-weight: [1, 1]){
                    example("Example"){
                        text("Shows a concrete application or worked case.")
                    }
                    remark("Remark"){
                        text("Adds a clarification or important side note.")
                    }
                }
            }

            pageNote("Academic wrappers share the callout layout with semantic titles, accents and backgrounds.")
        }
    }
}

@define info-badge(label, count: 1, accent: documentColors[0]){
    group(margin: 1, size: (100, 40)){
        rectangle(
            background-color: linearGradientColor(
                lighterColor(accent, 0.25), accent, 90),
            round-corner: 12,
            shadow: {distance: (0, 2), radius: 5,
                     color: darkerColor(accent, 0.35)}
        )
        text("${label}: ${count}", color: white, font-bold,
             font-size: 2.0%P, at: center)
    }
}

@define feature-box(title, accent: documentColors[1]){
    group(margin: 1, size: (100, 100)){
        rectangle(background-color: documentSurface,
                  color: documentLine, draw-contour, round-corner: 6)
        rectangle(background-color: accent,
                  position: (1.2, 50), size: (0.35%P, 90),
                  origin: left)
        text("${title}", position: (6, 14), origin: left,
             font-bold, font-size: 2.0%P, color: accent)
        group(position: (6, 32), size: (88, 62),
              origin: top-left){ slot }
    }
}

content-slide(title: "Custom Components (@define)"){
    body{
        col(rows-weight: [6, 94]){
            sectionLabel("Components")

            grid((2, 2), columns-weight: [1, 1], rows-weight: [0.75, 1.25]){
                sourcePanel(
                    """@define info-badge(label, count: 1,
                  accent: documentColors[0]){
  group(margin: 1, size: (100, 40)){
    rectangle(
      background-color: linearGradientColor(
        lighterColor(accent, 0.25), accent, 90),
      round-corner: 12,
      shadow: {distance: (0, 2), radius: 5,
               color: darkerColor(accent, 0.35)})
    text("${label}: ${count}", color: white, font-bold,
         font-size: 2.0%P, at: center)
  }
}""",
                    title: "1 · Parameters, defaults and depth",
                    fontSize: 1.35%P
                )

                demoPanel("Live badge"){
                    group(position: (50, 36), size: (60, 60), origin: center){
                        info-badge(label: "Pending Tasks", count: 7, accent: documentColors[0])
                    }
                    text("count defaults to 1; accent accepts a color expression.",
                         position: (50, 80), origin: center,
                         font-size: 1.8%P, color: documentTextSecondary, text-wrap: wrap)
                }

                sourcePanel(
                    """@define feature-box(title,
                   accent: documentColors[1]){
  group(margin: 1, size: (100, 100)){
    rectangle(background-color: documentSurface,
              color: documentLine, draw-contour, round-corner: 6)
    rectangle(background-color: accent,
              position: (1.2, 50), size: (0.35%P, 90),
              origin: left)
    text("${title}", position: (6, 14), origin: left,
         font-bold, font-size: 2.0%P, color: accent)
    group(position: (6, 32), size: (88, 62),
          origin: top-left){ slot }
  }
}""",
                    title: "2 · Caller content with slot",
                    fontSize: 1.25%P
                )

                demoPanel("Live feature box"){
                    feature-box(title: "Custom Component Box", accent: documentColors[1]){
                        ul(font-size: 1.5%P){
                            • "`@define` components"
                            • "Named arguments"
                            • "Caller `slot`"
                        }
                    }
                }
            }
        }
    }
}

content-slide(title: "Built-in Template Components"){
    body{
        col(rows-weight: [6, 94]){
            sectionLabel("Components")

            grid(3, 3, columns-weight: [1, 1, 1], rows-weight: [1.2, 0.9, 1.1]){
                styles{
                    text{ font-size: 2%P }
                    ul{ font-size: 2%P }
                    @ul-item{
                        font-size: 2%P
                        margin: (0.5, 0)
                        text-wrap: wrap
                    }
                }

                card(accentColor: documentColors[0]){
                    kicker("CARD")
                    ul{
                        • "Styled container"
                        • "Integrated accent"
                        • "Kicker + content slot"
                    }
                }

                card(accentColor: documentColors[1]){
                    stat(value: "99.9%", label: "Example availability",
                         accentColor: documentColors[1])
                }

                quote(author: "— Alan Kay"){
                    text("The best way to predict the future is to invent it.",
                         font-size: 1.65%P, font-italic, text-wrap: wrap)
                }

                image-fig(src: "../../../images/image.png",
                          title: "Figure",
                          legend: "Title + legend",
                          size: 32)

                hint-info("Information"){
                    text("Contextual tips for the current step.", font-size: 2%P)
                }

                hint-error("Important"){
                    text("Blocking issues or failed checks.", font-size: 2%P)
                }

                hint-warning("Warning"){
                    text("Cautions before continuing.", font-size: 2%P)
                }

                hint-success("Note"){
                    text("Passed checks or healthy services.", font-size: 2%P)
                }

                panel(title: "Panel"){
                    group(size: (100, 70)){
                        text("A neutral canvas for diagrams and details.",
                             color: documentTextSecondary, position: (50, 60),
                             origin: center, font-size: 2%P, text-wrap: wrap)
                    }
                }
            }
        }
    }
}

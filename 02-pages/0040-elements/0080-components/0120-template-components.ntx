content-slide(title: "Built-in Template Components", variant: 4){
    body{
        grid((3, 3), columns-weight: [1, 1, 1], rows-weight: [1, 1, 1]){
            styles:{
                "*": { margin: 2 }
            }

            // 1. Card with kicker
            card(accentColor: documentColors[0]){
                kicker("CARD COMPONENT")
                ul{
                    • "Auto-styled container"
                    • "Integrated left accent bar"
                    • "Embedded kicker support"
                }
            }

            // 2. Stat box
            card(accentColor: documentColors[1]){
                stat(value: "99.9%", label: "Availability SLA")
            }

            // 3. Quote
            quote(author: "Alan Kay"){
                text("The best way to predict the future is to invent it.",
                     font-size: 2.2%P, font-italic)
            }

            // 4. Image figure with title and legend
            image-fig(src: "../../../images/image.png", title: "Reusable figure", legend: "Title and legend stay with the image.", size: 45)

            // 5. Callout: hint-info
            hint-info("Information Callout"){
                text("Provides contextual tips and info blocks with semantic coloring.")
            }

            // 6. Callout: hint-error
            hint-error("Important Callout"){
                text("Use the error style for blocking issues, failed checks, and data loss risks.")
            }

            // 7. Callout: hint-warning
            hint-warning("Warning Callout"){
                text("Highlights cautions or critical notices with warning accent colors.")
            }

            // 8. Callout: hint-success
            hint-success("Success Callout"){
                text("Confirms a completed migration, a passed check, or a healthy service.")
            }

            // 9. Panel (light canvas)
            panel(title: "Panel: light canvas"){
                group(size: (100, 70)){
                    text("A neutral surface for diagrams and supporting details",
                         color: documentTextSecondary, position: (50, 65), origin: center, font-size: 1.8%P)
                }
            }
        }
    }
}

content-slide(title: "Images — Formats & Paths") {
    body {
        col(rows-weight: [6, 82, 12]) {
            sectionLabel("Media")
            grid((2, 3), columns-weight: [1, 2.2]) {
                demoPanel("PNG · image.png") {
                    image("../../../images/image.png", size: (50, 50), at: center, preserve-aspect-ratio)
                }
                sourcePanel(
                    """image("../../../images/image.png", size:(50,50), at:center, preserve-aspect-ratio)""",
                    title: "PNG · path relative to this file",
                    fontSize: 2.0%P
                )

                demoPanel("JPEG · image.jpg") {
                    image("../../../images/image.jpg", size: (50, 50), at: center, preserve-aspect-ratio)
                }
                sourcePanel(
                    """image("../../../images/image.jpg", size:(50,50), at:center, preserve-aspect-ratio)""",
                    title: "JPEG · path relative to this file",
                    fontSize: 2.0%P
                )

                demoPanel("GIF · image.gif") {
                    image("../../../images/image.gif", size: (50, 50), at: center, preserve-aspect-ratio)
                }
                sourcePanel(
                    """image("../../../images/image.gif", size:(50,50), at:center, preserve-aspect-ratio)""",
                    title: "GIF · animated in the viewer",
                    fontSize: 2.0%P
                )

                demoPanel("SVG · image.svg") {
                    image("../../../images/image.svg", size: (50, 50), at: center, preserve-aspect-ratio)
                }
                sourcePanel(
                    """image("../../../images/image.svg", size:(50,50), at:center, preserve-aspect-ratio)""",
                    title: "SVG · vector asset",
                    fontSize: 2.0%P
                )

                demoPanel("AVIF · image.avif") {
                    image("../../../images/image.avif", size: (50, 50), at: center, preserve-aspect-ratio)
                }
                sourcePanel(
                    """image("../../../images/image.avif", size:(50,50), at:center, preserve-aspect-ratio)""",
                    title: "AVIF · included ImageIO decoder",
                    fontSize: 2.0%P
                )

                demoPanel("WebP · image.webp") {
                    image("../../../images/image.webp", size: (50, 50), at: center, preserve-aspect-ratio)
                }
                sourcePanel(
                    """image("../../../images/image.webp", size:(50,50), at:center, preserve-aspect-ratio)""",
                    title: "WebP · included ImageIO decoder",
                    fontSize: 2.0%P
                )
            }
            pageNote("Paths are relative to this file. AVIF and WebP use included ImageIO decoders; all previews preserve their aspect ratio.")
        }
    }
}

content-slide(title:"Positions", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · anchors and origins")
        grid(2, 8,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            miniPage{
                rectangle(at:center, size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(24,24))
            """)

            miniPage{
                rectangle(at:top, size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:top, size:(24,24))
            """)

            miniPage{
                rectangle(at:top-left, size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:top-left, size:(24,24))
            """)

            miniPage{
                rectangle(at:bottom-right, size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:bottom-right, size:(24,24))
            """)

            miniPage{
                rectangle(origin:(50,50), position:(25,25),
                    size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(origin:(50,50),
                  position:(25,25), size:(24,24))
            """)

            miniPage{
                rectangle(origin:(75,75), position:(30,30),
                    size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(origin:(75,75),
                  position:(30,30), size:(24,24))
            """)

            miniPage{
                rectangle(origin:(100,100), position:(35,35),
                    size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(origin:(100,100),
                  position:(35,35), size:(24,24))
            """)

            miniPage{
                rectangle(origin:(100,100), position:(25,25),
                    size:(24,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(origin:(100,100),
                  position:(25,25), size:(24,24))
            """)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Keep explicit positions inside the card; origin shifts the reference point within the shape.")
        }
    }
}

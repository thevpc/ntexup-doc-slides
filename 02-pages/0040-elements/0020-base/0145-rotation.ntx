content-slide(title:"Rotation", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · rotation and pivot")
        grid(2, 4,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.8])
        {
            demoPanel("Rotated rectangle"){
                rectangle(origin:center, position:(50,60), size:(50,32),
                    background-color:documentColors[4],
                    rotate:45)
            }
            sourcePanel("""
                rectangle(origin:center, position:(50,60), size:(50,32),
                  background-color:documentColors[4],
                  rotate:45)
            """, title:"", fontSize:2%P)

            demoPanel("Rotated text"){
                text("Rotated Label", font-bold,
                    rotate:-25, at:center,
                    font-size:3.2%P,
                    color:documentColors[1])
            }
            sourcePanel("""
                text("Rotated Label", font-bold,
                  rotate:-25, at:center,
                  font-size:3.2%P,
                  color:documentColors[1])
            """, title:"", fontSize:2%P)

            demoPanel("Center vs top-left pivot"){
                grid(2, 1){
                    miniPage{
                        rectangle(at:center, size:(60,35),
                            background-color:documentColors[4], rotate:30)
                    }
                    miniPage{
                        rectangle(at:center, size:(60,35),
                            background-color:documentColors[4], rotate:(30,0,0))
                    }
                }
            }
            sourcePanel("""
                rectangle(at:center, size:(60,35),
                  background-color:documentColors[4], rotate:30)
                rectangle(at:center, size:(60,35),
                  background-color:documentColors[4], rotate:(30,0,0))
            """, title:"Center and top-left pivots", fontSize:2%P)

            demoPanel("Multiple rotations"){
                rectangle(origin:center, position:(50,60), size:(42,42),
                    background-color:documentColors[4], rotate:15)
                rectangle(origin:center, position:(50,60), size:(42,42),
                    background-color:documentColors[3], rotate:60)
            }
            sourcePanel("""
                rectangle(origin:center, position:(50,60), size:(42,42),
                  background-color:documentColors[4], rotate:15)
                rectangle(origin:center, position:(50,60), size:(42,42),
                  background-color:documentColors[3], rotate:60)
            """, title:"", fontSize:2%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("rotate uses degrees; a tuple supplies (angle, x-pivot, y-pivot) in element percentages.")
        }
    }
}

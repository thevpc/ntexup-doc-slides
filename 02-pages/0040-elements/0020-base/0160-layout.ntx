content-slide(title:"Layout",variant:4){
    body{
        grid(4,2,columns-weight:[1,2]){
            styles:{
                "*": {margin:2}
            }
            // Row
            miniPage{
                group{
                  rectangle(at:top, size:(50,50), background-color:documentColors[4], color:documentColors[2], margin:10)
                  triangle(at:left, size:(50,50), background-color:documentColors[5], color:documentColors[5], margin:10)
                }
            }
            miniCodeNTexup( """
                group{
                  rectangle(at:top,
                      size:(50,50),
                      background-color:
                        documentColors[4]
                  )
                  triangle(at:left,
                      size:(50,50),
                      background-color:
                        documentColors[5]
                  )
                }
            """)

            // Row
            miniPage{
                grid((2,2)){
                    rectangle(at:top, size:(50,50), background-color:documentColors[4], color:documentColors[2], margin:10)
                    triangle(at:left, size:(50,50), background-color:documentColors[5], color:documentColors[5], margin:10)
                    "Hello"
                }
            }
            miniCodeNTexup( """
                grid((2,2)){
                  rectangle(at:top,
                    size:(50,50),
                    background-color:
                      documentColors[4]
                  )
                  triangle(at:left,
                    size:(50,50),
                    background-color:
                      documentColors[5]
                  )
                }
            """)

            // Row
            miniPage{
                grid((3,2),columns-weight:[1,4],rows-weight:[1,4]){
                    rectangle(background-color:documentColors[4], color:documentColors[2], margin:10)
                    triangle(background-color:documentColors[5], color:documentColors[5], margin:10)
                    rectangle(background-color:documentColors[4], color:documentColors[2], margin:10)
                    triangle(background-color:documentColors[5], color:documentColors[5], margin:10)
                    rectangle(background-color:documentColors[4], color:documentColors[2], margin:10)
                    triangle(background-color:documentColors[5], color:documentColors[5], margin:10)
                }
            }
            miniCodeNTexup( """
                grid((3,2),
                    columns-weight:[1,4],
                    rows-weight:[1,4]){
                        rectangle()
                        triangle()
                        rectangle()
                        triangle()
                        rectangle()
                        triangle()
                }
             """)



        }
    }

}

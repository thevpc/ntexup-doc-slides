content-slide(title:"Grid Layouts & Spanning",variant:4){
    body{
        grid((4,2),columns-weight:[1,1.5]){
            styles:{
                "*": {margin:2}
                source:{
                    at:left
                }
            }

            // Item 1: Colspan across multiple columns
            miniPage{
                grid(3, 2, draw-grid, line-color:documentColors[0]){
                    rectangle(colspan:2, background:documentColors[0], color:white, at:center){
                        text("Header (colspan: 2)", color:white, font-bold, at:center)
                    }
                    rectangle(background:documentColors[4], at:center){ text("A", font-bold, at:center) }
                    rectangle(background:documentColors[3], at:center){ text("B", font-bold, at:center) }
                }
            }
            miniCodeNTexup(
            """
            grid(3, 2, draw-grid){
              rectangle(colspan:2,
                        background:documentColors[0]){
                text("Header (colspan: 2)",
                     color:white)
              }
              rectangle(){ text("A") }
              rectangle(){ text("B") }
            }
            """
            )

            // Item 2: Rowspan across multiple rows
            miniPage{
                grid(2, 2, draw-grid, line-color:documentColors[1]){
                    rectangle(rowspan:2, background:documentColors[1], color:white, at:center){
                        text("Side", color:white, font-bold, at:center)
                    }
                    rectangle(background:documentColors[4], at:center){ text("Top", at:center) }
                    rectangle(background:documentColors[3], at:center){ text("Bottom", at:center) }
                }
            }
            miniCodeNTexup(
            """
            grid(2, 2, draw-grid){
              rectangle(rowspan:2,
                        background:documentColors[1]){
                text("Side")
              }
              rectangle(){ text("Top") }
              rectangle(){ text("Bottom") }
            }
            """
            )

            // Item 3: Columns & Rows Weight
            miniPage{
                grid(2, 2, draw-grid, columns-weight:[1, 3], rows-weight:[1, 2], line-color:documentColors[0]){
                    rectangle(background:documentColors[0], at:center){ text("1x1", color:white, at:center) }
                    rectangle(background:documentColors[4], at:center){ text("3x1", color:white, at:center) }
                    rectangle(background:documentColors[3], at:center){ text("1x2", color:white, at:center) }
                    rectangle(background:documentColors[2], at:center){ text("3x2", color:white, at:center) }
                }
            }
            miniCodeNTexup(
            """
            grid(2, 2, draw-grid,
                 columns-weight:[1, 3],
                 rows-weight:[1, 2]){
              rectangle(){ text("1x1") }
              rectangle(){ text("3x1") }
              rectangle(){ text("1x2") }
              rectangle(){ text("3x2") }
            }
            """
            )

            // Item 4: Empty spacer cell with void()
            miniPage{
                grid(3, 2, draw-grid, line-color:documentColors[2]){
                    rectangle(colspan:3, background:documentColors[2], at:center){
                        text("Banner", color:white, font-bold, at:center)
                    }
                    rectangle(background:documentColors[4], at:center){ text("L", at:center) }
                    void()
                    rectangle(background:documentColors[4], at:center){ text("R", at:center) }
                }
            }
            miniCodeNTexup(
            """
            grid(3, 2, draw-grid){
              rectangle(colspan:3){
                text("Banner")
              }
              rectangle(){ text("L") }
              void() // empty spacer
              rectangle(){ text("R") }
            }
            """
            )
        }
    }
}

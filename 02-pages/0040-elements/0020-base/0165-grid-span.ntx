content-slide(title:"Grid Layouts & Spanning", section:"Layout & styling"){
    body{
        c := documentColors
        sectionLabel("Base elements · spanning, weights and spacers")
        grid(2, 2,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 1], rows-weight:[1, 1])
        {
            group(margin:2){
                rectangle(background-color:documentBg, draw-contour,
                    line-color:documentLine, round-corner:6)
                group(position:(2, 4), size:(96, 92), origin:top-left){
                    row(columns-weight:[1, 2]){
                        demoPanel("Colspan"){
                            grid(3, 2, draw-grid, font-bold,
                                font-size:2.2%P)
                            {
                                rectangle(colspan:2, at:center,
                                    bg:c[0]){
                                    text("Wide", at:center, color:white)
                                }
                                rectangle(at:center, bg:c[4]){
                                    text("A", at:center)
                                }
                                rectangle(at:center, bg:c[3]){
                                    text("B", at:center)
                                }
                            }
                        }
                        miniCodeNTexup("""
                            c := documentColors
                            grid(3,2,draw-grid,font-bold,
                              font-size:2.2%P){
                              rectangle(colspan:2,at:center,
                                bg:c[0]){
                                text("Wide",at:center,color:white)}
                              rectangle(at:center,bg:c[4]){
                                text("A",at:center)}
                              rectangle(at:center,bg:c[3]){
                                text("B",at:center)}
                            }
                        """, fontSize:1.2%P)
                    }
                }
            }

            group(margin:2){
                rectangle(background-color:documentBg, draw-contour,
                    line-color:documentLine, round-corner:6)
                group(position:(2, 4), size:(96, 92), origin:top-left){
                    row(columns-weight:[1, 2]){
                        demoPanel("Rowspan"){
                            grid(2, 2, draw-grid, font-bold,
                                font-size:2.2%P)
                            {
                                rectangle(rowspan:2, at:center,
                                    bg:c[1]){
                                    text("Side", at:center, color:white)
                                }
                                rectangle(at:center, bg:c[4]){
                                    text("Top", at:center)
                                }
                                rectangle(at:center, bg:c[3]){
                                    text("Bottom", at:center)
                                }
                            }
                        }
                        miniCodeNTexup("""
                            c := documentColors
                            grid(2,2,draw-grid,font-bold,
                              font-size:2.2%P){
                              rectangle(rowspan:2,at:center,
                                bg:c[1]){
                                text("Side",at:center,color:white)}
                              rectangle(at:center,bg:c[4]){
                                text("Top",at:center)}
                              rectangle(at:center,bg:c[3]){
                                text("Bottom",at:center)}
                            }
                        """, fontSize:1.2%P)
                    }
                }
            }

            group(margin:2){
                rectangle(background-color:documentBg, draw-contour,
                    line-color:documentLine, round-corner:6)
                group(position:(2, 4), size:(96, 92), origin:top-left){
                    row(columns-weight:[1.3, 2]){
                        demoPanel("Weights"){
                            grid(2, 2, draw-grid, font-size:1.6%P,
                                columns-weight:[1, 3], rows-weight:[1, 2])
                            {
                                rectangle(at:center, bg:c[0]){
                                    text("1x1", at:center, color:white)
                                }
                                rectangle(at:center, bg:c[4]){
                                    text("3x1", at:center)
                                }
                                rectangle(at:center, bg:c[3]){
                                    text("1x2", at:center)
                                }
                                rectangle(at:center, bg:c[2]){
                                    text("3x2", at:center)
                                }
                            }
                        }
                        miniCodeNTexup("""
                            c := documentColors
                            grid(2,2,draw-grid,font-size:1.6%P,
                              columns-weight:[1,3],
                              rows-weight:[1,2]){
                              rectangle(at:center,bg:c[0]){
                                text("1x1",at:center,color:white)}
                              rectangle(at:center,bg:c[4]){
                                text("3x1",at:center)}
                              rectangle(at:center,bg:c[3]){
                                text("1x2",at:center)}
                              rectangle(at:center,bg:c[2]){
                                text("3x2",at:center)}
                            }
                        """, fontSize:1.2%P)
                    }
                }
            }

            group(margin:2){
                rectangle(background-color:documentBg, draw-contour,
                    line-color:documentLine, round-corner:6)
                group(position:(2, 4), size:(96, 92), origin:top-left){
                    row(columns-weight:[1, 2]){
                        demoPanel("Spacer"){
                            grid(3, 2, draw-grid, font-size:2.2%P){
                                rectangle(colspan:3, at:center,
                                    bg:c[2]){
                                    text("Banner", at:center, font-bold)
                                }
                                rectangle(at:center, bg:c[4]){
                                    text("L", at:center)
                                }
                                void()
                                rectangle(at:center, bg:c[4]){
                                    text("R", at:center)
                                }
                            }
                        }
                        miniCodeNTexup("""
                            c := documentColors
                            grid(3,2,draw-grid,font-size:2.2%P){
                              rectangle(colspan:3,at:center,
                                bg:c[2]){
                                text("Banner",at:center,font-bold)}
                              rectangle(at:center,bg:c[4]){
                                text("L",at:center)}
                              void() // empty spacer
                              rectangle(at:center,bg:c[4]){
                                text("R",at:center)}
                            }
                        """, fontSize:1.2%P)
                    }
                }
            }
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("`c` aliases the classic palette; each complete snippet mirrors its live grid, with dark labels on light fills.")
        }
    }
}

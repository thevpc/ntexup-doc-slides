content-slide(title:"Shapes", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · shape primitives")
        grid(2, 8,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            miniPage{
                rectangle(at:center, size:(80,55),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(80,55),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                triangle(at:center, size:(75,75),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                triangle(at:center, size:(75,75),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                square(at:center, size:(75,75),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                square(at:center, size:(75,75),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rhombus(at:center, size:(80,65),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rhombus(at:center, size:(80,65),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                parallelogram(at:center, size:(80,60),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                parallelogram(at:center, size:(80,60),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                trapezoid(at:center, size:(80,60),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                trapezoid(at:center, size:(80,60),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                circle(at:center, size:(75,75),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                circle(at:center, size:(75,75),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                ellipse(at:center, size:(85,65),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                ellipse(at:center, size:(85,65),
                  background-color:documentColors[4])
            """, fontSize:2%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Snippets isolate geometry; every preview uses the same accent fill.")
        }
    }
}

content-slide(title:"Shapes", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · shape primitives")
        grid(2, 8,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            miniPage{
                rectangle(at:center, size:(50,20),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(50,20))
            """)

            miniPage{
                triangle(at:center, size:32,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                triangle(at:center, size:32)
            """)

            miniPage{
                square(at:center, size:32,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                square(at:center, size:32)
            """)

            miniPage{
                rhombus(at:center, size:32,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rhombus(at:center, size:32)
                diamond(at:center, size:32) // alias
            """)

            miniPage{
                parallelogram(at:center, size:32,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                parallelogram(at:center, size:32)
            """)

            miniPage{
                trapezoid(at:center, size:32,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                trapezoid(at:center, size:32)
            """)

            miniPage{
                circle(at:center, size:32,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                circle(at:center, size:32)
            """)

            miniPage{
                ellipse(at:center, size:(60,24),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                ellipse(at:center, size:(60,24))
            """)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Snippets isolate geometry; every preview uses the same accent fill and contour.")
        }
    }
}

content-slide(title:"Sizes", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · absolute and page-relative size")
        grid(2, 7,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            miniPage{
                rectangle(at:center,
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center,
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rectangle(at:center, size:(55,45),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(55,45),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rectangle(at:center, size:60,
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:60,
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rectangle(at:center, size:45,
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:45,
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rectangle(at:center, size:32,
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:32,
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rectangle(at:center, size:(30,55),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(30,55),
                  background-color:documentColors[4])
            """, fontSize:2%P)

            miniPage{
                rectangle(at:center, size:(12%P,6%P),
                    background-color:documentColors[4])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(12%P,6%P),
                  background-color:documentColors[4])
            """, fontSize:2%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Bare sizes are points; plain tuples are container-relative and %P is page-relative.")
        }
    }
}

content-slide(title:"Sizes", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · absolute and page-relative size")
        grid(2, 7,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 2.2])
        {
            miniPage{
                rectangle(at:center,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center)
            """)

            miniPage{
                rectangle(at:center, size:(40,30),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(40,30))
            """)

            miniPage{
                rectangle(at:center, size:40,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:40)
            """)

            miniPage{
                rectangle(at:center, size:30,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:30)
            """)

            miniPage{
                rectangle(at:center, size:20,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:20)
            """)

            miniPage{
                rectangle(at:center, size:(20,40),
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:(20,40))
            """)

            miniPage{
                rectangle(at:center, size:6%P,
                    background-color:documentColors[4],
                    color:documentColors[2])
            }
            miniCodeNTexup("""
                rectangle(at:center, size:6%P)
            """)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Bare sizes are points; %P is page-relative and is chosen here to fit inside the card.")
        }
    }
}

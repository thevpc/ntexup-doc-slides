content-slide(title:"Strokes & Shadows",variant:5){
    body{
        grid((4,2),columns-weight:[1,1.5]){
            styles:{
                "*": {margin:2}
                source:{
                    at:left
                }
            }

            // Row 1: Dashed stroke & line-color
            miniPage{
                rectangle(at:center, size:(60,25), background-color:documentColors[4], draw-contour, line-color:documentColors[0], stroke:dashed)
            }
            miniCodeNTexup(
            """
            rectangle(
              size:(60,25),
              background-color:documentColors[4],
              draw-contour,
              line-color:documentColors[0],
              stroke:dashed
            )
            """
            )

            // Row 2: Basic stroke with custom width and dash pattern
            miniPage{
                rectangle(at:center, size:(60,25), background-color:documentColors[4], draw-contour, line-color:documentColors[1], stroke:basic(width:2, dash:[8,4], cap:round))
            }
            miniCodeNTexup(
            """
            rectangle(
              size:(60,25),
              draw-contour,
              line-color:documentColors[1],
              stroke:basic(width:2,
                           dash:[8,4],
                           cap:round)
            )
            """
            )

            // Row 3: Drop shadow on shape/card
            miniPage{
                rectangle(at:center, size:(55,22), background-color:documentColors[0], color:white, shadow:{distance:(4,4), radius:6, color:gray})
            }
            miniCodeNTexup(
            """
            rectangle(
              size:(55,22),
              background-color:documentColors[0],
              shadow:{
                distance:(4,4),
                radius:6,
                color:gray
              }
            )
            """
            )

            // Row 4: Drop shadow on text
            miniPage{
                text("Elevated Text", font-bold, at:center, font-size:3%P, color:documentColors[1], shadow:{distance:(3,3), radius:4, color:gray})
            }
            miniCodeNTexup(
            """
            text(
              "Elevated Text",
              font-bold,
              color:documentColors[1],
              shadow:{
                distance:(3,3),
                radius:4,
                color:gray
              }
            )
            """
            )
        }
    }
}

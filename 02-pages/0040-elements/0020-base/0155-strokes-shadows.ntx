content-slide(title:"Strokes & Shadows", section:"Layout & styling"){
    body{
        sectionLabel("Base elements · contours and depth")
        grid(2, 4,
            position:(0, 7), size:(100, 86), origin:top-left,
            columns-weight:[1, 1.8])
        {
            demoPanel("Dashed contour"){
                rectangle(at:center, size:(60,25),
                    background-color:documentColors[4],
                    draw-contour, line-color:documentColors[0],
                    stroke:dashed)
            }
            sourcePanel("""
                rectangle(at:center, size:(60,25),
                  background-color:documentColors[4],
                  draw-contour,
                  line-color:documentColors[0],
                  stroke:dashed)
            """, fontSize:2.1%P)

            demoPanel("Custom width and dash"){
                rectangle(at:center, size:(60,25),
                    background-color:documentColors[4],
                    draw-contour, line-color:documentColors[1],
                    stroke:basic(width:2,
                        dash:[8,4], cap:round))
            }
            sourcePanel("""
                rectangle(at:center, size:(60,25),
                  background-color:documentColors[4],
                  draw-contour,
                  line-color:documentColors[1],
                  stroke:basic(width:2,
                    dash:[8,4], cap:round))
            """, fontSize:2.1%P)

            demoPanel("Shadow with visible contour"){
                rectangle(at:center, size:(55,22),
                    background-color:documentColors[0],
                    draw-contour, line-color:white,
                    shadow:{distance:(4,4),
                        radius:6, color:gray})
            }
            sourcePanel("""
                rectangle(at:center, size:(55,22),
                  background-color:documentColors[0],
                  draw-contour, line-color:white,
                  shadow:{distance:(4,4),
                    radius:6, color:gray})
            """, fontSize:2.1%P)

            demoPanel("Text shadow"){
                text("Elevated Text", font-bold,
                    at:center, font-size:3%P,
                    color:documentColors[1],
                    shadow:{distance:(3,3),
                        radius:4, color:gray})
            }
            sourcePanel("""
                text("Elevated Text", font-bold,
                  at:center, font-size:3%P,
                  color:documentColors[1],
                  shadow:{distance:(3,3),
                    radius:4, color:gray})
            """, fontSize:2.1%P)
        }
        group(position:(0, 95), size:(100, 5), origin:top-left){
            pageNote("Contours require draw-contour; line-color paints the stroke and font-size controls text shadows.")
        }
    }
}

content-slide(title: "Line & Area Charts") {
    body {
        col(rows-weight: [6, 86, 8]) {
            sectionLabel("Data visualization")
            grid((2, 2), columns-weight: [1, 1.55]) {
                demoPanel("Filled area · nonlinear decay") {
                    plot2d(x: dtimes(-10, 10, 500)) {
                        area {
                            f(x): "100*abs(cos(pow(abs(x),1.5))/(1+0.2*abs(x)))"
                            title: "my function"
                        }
                    }
                }
                sourcePanel(
                    """
plot2d(x:dtimes(-10,10,500)){
  area{
    f(x):"100*abs(cos(pow(abs(x),1.5))/(1+0.2*abs(x)))"
    title:"my function"
  }
}
""",
                    title: "Area chart · complete example",
                    fontSize: 2.2%P
                )

                demoPanel("Line + area · sine and cosine") {
                    plot2d(x: dtimes(-5, 5, 100)) {
                        curve {
                            f(x): sin(x)
                            title: 'sin'
                        }
                        area {
                            f(x): cos(x)
                            title: 'cos'
                        }
                    }
                }
                sourcePanel(
                    """
plot2d(x:dtimes(-5,5,100)){
  curve{
    f(x):sin(x)
    title:'sin'
  }
  area{
    f(x):cos(x)
    title:'cos'
  }
}
""",
                    title: "Combined chart · complete example",
                    fontSize: 2.2%P
                )
            }
            pageNote("dtimes(start, stop, count) samples the x-axis. curve draws a line; area fills the region to the baseline.")
        }
    }
}

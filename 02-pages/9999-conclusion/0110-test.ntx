content-slide(title: "Try it yourself"){
    body{
        col(rows-weight: [6, 86, 8]){
            sectionLabel("Practice")

            grid((3, 1), columns-weight: [1.05, 1.1, 1.25]){
                sourcePanel(
                    """import("stdlib" "layout" "text")

page {
  text("Hello from **ntexup**!",
       at: center, font-size: 6%P,
       font-bold)
}
""",
                    title: "hello.ntx · complete example",
                    fontSize: 1.65%P
                )

                demoPanel("1 · Check strictly"){
                    group(position: (50, 34), size: (92, 30), origin: center){
                        miniCodeNTexup(
                            """nuts -y ntexup check \
  hello.ntx --strict""",
                            fontSize: 1.25%P
                        )
                    }
                    text("**0 errors · 0 warnings**",
                         position: (50, 66), origin: center,
                         font-size: 1.55%P, color: documentColors[2],
                         text-align: center)
                    text("Fix any diagnostics, then run the same check again.",
                         position: (50, 80), origin: center,
                         font-size: 1.3%P, color: documentTextSecondary,
                         text-wrap: wrap, text-align: center)
                }

                demoPanel("2 · Verify the output"){
                    grid(1, 4, size: (100, 100),
                        rows-weight: [0.8, 1, 1.15, 1.15]){
                        grid((2, 1), columns-weight: [7, 93]){
                            text("**1**", font-size: 1.8%P,
                                 color: documentColors[0])
                            text("Save **hello.ntx** and open a terminal in that folder.",
                                 font-size: 1.4%P, text-wrap: wrap)
                        }
                        grid((2, 1), columns-weight: [7, 93]){
                            text("**2**", font-size: 1.8%P,
                                 color: documentColors[0])
                            text("Run the strict check shown on the left.",
                                 font-size: 1.4%P, text-wrap: wrap)
                        }
                        grid((2, 1), columns-weight: [7, 93]){
                            text("**3**", font-size: 1.8%P,
                                 color: documentColors[0])
                            text("""Render with
`nuts -y ntexup image -o preview/ hello.ntx`.""",
                                 font-size: 1.35%P, text-wrap: wrap)
                        }
                        grid((2, 1), columns-weight: [7, 93]){
                            text("**4**", font-size: 1.8%P,
                                 color: documentColors[0])
                            text("""Open **preview/page-01.png** and confirm the centered bold text.""",
                                 font-size: 1.35%P, text-wrap: wrap)
                        }
                    }
                }
            }

            pageNote("A successful check reports 0 errors and 0 warnings; rendering then produces preview/page-01.png. No theme or repository setup is needed.")
        }
    }
}

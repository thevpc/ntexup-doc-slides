content-slide(title:"Why ntexup?", section:"Chapter 01 · Get started"){
    body{
        sectionLabel("Text-first documents, built to last")
        grid(2, 2,
            position:(0, 8), size:(100, 86), origin:top-left,
            rows-weight:[1, 1])
        {
            styles{
                "*": {margin:1}
                @ul-item{
                    font-size:1.65%P
                    margin:(0.6, 0)
                    text-wrap:wrap
                }
                @ul-bullet{ size:1.1%P }
            }
            card(accentColor:documentColors[0]){
                kicker("READABLE")
                ul(bullet-align:top){
                    • "Declarative TSON is easy to read and write"
                    • "Author once, render consistently"
                    • "Variables and conditions shape output"
                }
            }
            card(accentColor:documentColors[1]){
                kicker("REUSABLE")
                ul(bullet-align:top){
                    • "Precise control over rendered elements"
                    • "Reusable, composable nodes"
                    • "CSS-like styles and templates"
                }
            }
            card(accentColor:documentColors[2]){
                kicker("MAINTAINABLE")
                ul(bullet-align:top){
                    • "Multi-file projects scale naturally"
                    • "Git-friendly, reviewable source"
                    • "Consistent, long-lived themes"
                }
            }
            card(accentColor:documentColors[3]){
                kicker("PORTABLE")
                ul(bullet-align:top){
                    • "Cross-platform with minimal setup"
                    • "LaTeX, UML, and integrations"
                    • "Slides, images, and PDF from one source"
                }
            }
        }
    }
}

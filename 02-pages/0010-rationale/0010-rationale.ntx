content-slide(title:"Why ntexup?", section:"Get started"){
    body{
        sectionLabel("Text-first documents, built to last")
        grid(2, 2,
            position:(0, 8), size:(100, 86), origin:top-left,
            rows-weight:[1, 1])
        {
            styles{
                "*": {margin:1}
            }
            card(accentColor:documentColors[0]){
                kicker("READABLE")
                ul(bullet-align:top){
                    • "Declarative TSON stays easy to read and write"
                    • "What you author is what you render"
                    • "Variables and conditions parameterize output"
                }
            }
            card(accentColor:documentColors[1]){
                kicker("REUSABLE")
                ul(bullet-align:top){
                    • "Fine-grained control over every rendered element"
                    • "Compose nodes into reusable components"
                    • "Define templates with CSS-like styles"
                }
            }
            card(accentColor:documentColors[2]){
                kicker("MAINTAINABLE")
                ul(bullet-align:top){
                    • "Multi-file projects scale naturally"
                    • "Git-friendly source stays easy to review"
                    • "Themes keep long-lived documents consistent"
                }
            }
            card(accentColor:documentColors[3]){
                kicker("PORTABLE")
                ul(bullet-align:top){
                    • "Run across platforms with minimal setup"
                    • "Integrate LaTeX, UML, and more"
                    • "Render one source to slides, images, or PDF"
                }
            }
        }
    }
}

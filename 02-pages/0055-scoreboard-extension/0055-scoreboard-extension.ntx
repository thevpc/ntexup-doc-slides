content-slide(title: "Scoreboard Extension"){
    body{
        col(rows-weight: [6, 86, 8]){
            sectionLabel("Extensions")

            grid(2, 1, columns-weight: [1.65, 1]){
                // The screen viewer counts scores up, grows bars and reorders rows.
                // Static PDF/image output renders the final sorted ranking.
                scoreboard(
                    title: "Cartoon Duo Challenge",
                    subtitle: "Final round · 7 teams",
                    theme: "dark",
                    duration: 3,
                    stagger: 0.09,
                    pulse: true,
                    icon: "../../images/image.png",
                    scores: [
                        {name: "Tom", sub-name: "And Jerry", score: 62.5},
                        {name: "Rick", sub-name: "And Morty", score: 49.0},
                        {name: "Timon", sub-name: "And Pumbaa", score: 79.5},
                        {name: "Pinky", sub-name: "And The Brain", score: 57.75},
                        {name: "Fred Flintstone", sub-name: "And Barney Rubble", score: 42.75},
                        {name: "Snoopy", sub-name: "And Woodstock", score: 69.5},
                        {name: "Tweety", sub-name: "And Sylvester", score: 74.25}
                    ]
                )

                col(rows-weight: [10, 66, 24]){
                    text("**One component, one ranked list.**", font-size: 2.3%P)

                    sourcePanel(
                        """
scoreboard(
  title: "Cartoon Duo Challenge",
  subtitle: "Final round · 7 teams",
  theme: "dark",
  scores: [
    {name: "Timon", sub-name: "And Pumbaa",
     score: 79.5},
    {name: "Tweety", sub-name: "And Sylvester",
     score: 74.25},
    {name: "Snoopy", sub-name: "And Woodstock",
     score: 69.5}
  ]
)
""",
                        title: "Excerpt · top 3 of 7 live entries",
                        fontSize: 1.7%P
                    )

                    grid(1, 1, size: (100, 100)){
                        text("Also accepts inline TSON/CSV or TSON/JSON/YAML/CSV files, custom palettes and themes.",
                             font-size: 1.8%P, color: documentTextSecondary,
                             text-wrap: wrap)
                    }
                }
            }

            pageNote("Classic already imports scoreboard. The excerpt omits the icon, animation options and four lower-ranked entries.")
        }
    }
}

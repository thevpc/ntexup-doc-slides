content-slide(title: "Table Extension"){
    styles{
        @highlight{
            background-color: documentSurfaceAlt
            table-header{
                font-bold
                color: white
                background-color: documentColors[2]
            }
        }
    }

    body{
        col(rows-weight: [6, 94]){
            sectionLabel("Extensions")

            grid(2, 1, columns-weight: [0.85, 1.8]){
                styles{
                    @ul-item{
                        font-size: 1.55%P
                        margin: (0.6, 0)
                        text-wrap: wrap
                    }
                    @ul-bullet{
                        size: 1.0%P
                    }
                }
                ul(font-size: 1.55%P){
                    • "Theme defaults style headers, zebra rows and grid lines."
                    • "header-data, data and footer-data define table content."
                    • "table-striped and table-bordered style headers."
                    • "Selectors target rows, columns, cells and classes."
                    • "Weights use data-relative indices."
                }

                grid((2, 2), columns-weight: [1, 1], rows-weight: [1.25, 1]){
                    styles{
                        col{ margin: 0.6 }
                        table{ font-size: 2.5%P }
                        table-cell{ padding: (0.18%P, 0.12%P) }
                    }

                    col{
                        text("**Default Table**", font-size: 2.1%P)
                        table(
                            header-data: [["Name", "Age"]],
                            data: [
                                ["Alice", 30],
                                ["Bob", 25]
                            ]
                        )
                    }

                    col{
                        text("**Striped Table**", font-size: 2.1%P)
                        @(table-striped) table(
                            header-data: [["Item", "Qty", "Price"]],
                            data: [
                                ["Apple", 5, 0.5],
                                ["Banana", 3, 0.3]
                            ]
                        )
                    }

                    col{
                        text("**Bordered Table**", font-size: 2.1%P)
                        @(table-bordered) table(
                            header-data: [["Name", "Role"]],
                            data: [
                                ["Ada", "Engineer"],
                                ["Grace", "Admiral"]
                            ]
                        )
                    }

                    col{
                        text("**Custom Class**", font-size: 2.1%P)
                        @(highlight) table(
                            header-data: [["x", "y", "xy"]],
                            data: [
                                ["1", "2", "2"],
                                ["3", "4", "12"]
                            ]
                        )
                    }
                }
            }
        }
    }
}

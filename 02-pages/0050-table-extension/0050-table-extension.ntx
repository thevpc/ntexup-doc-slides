import("table")
content-slide(title:"Table Extension"){
    styles{
        table-header: { background-color: "#1e293b", color: "#f8fafc", font-bold }
        table-header(row: 1, col: 1): { background-color: "#2563eb", color: "#ffffff" }
        table-row(row: even): { background-color: "#f1f5f9" }
        table-row(row: odd): { background-color: "#ffffff" }
        table-cell: { font-size : 3%P}
        table-column(col: 3): { color: "#059669", font-bold, column-weight: 2 }
        table(class-highlight): { background-color: "#fef3c7" }
        table-row(row: 1): { row-weight: 2 }
    }
    body{
        grid(2,2){
            ul{
                •¶ The table extension provides a easy way to create tabular data.
                •¶ Supports data, headerData, bodyData, footerData parameters.
                •¶ Supports style selectors: table-header(row: n[, col: m]), table-row(row: n | even/odd), table-footer(row: n), table-column(col: n), table-cell(row: r, col: c), table(class-name).
                •¶ Sizing: row-weight / column-weight on any row/column/cell selector — the table takes the max weight per row and per column (per-cell equivalent of rows-weight: [1, 1, 3]). Row indices are data-relative (row: 1 = first data row); headers/footers via table-header(row: n) / table-footer(row: n).
            }
            // Example 1: Simple data
            row{
                text("**Simple Table:**",font-size:2.5%P)
                table(data: [
                    ["Name", "Age"],
                    ["Alice", 30],
                    ["Bob", 25]
                ],draw-grid:true,padding:1)
            }
            // Example 2: With header, body, footer and styling
            row{
                text("**Styled Table:**",font-size:2.5%P)
                table(
                    header-data: [["Item", "Qty", "Price"]],
                    data: [
                        ["Apple", 5, 0.5],
                        ["Banana", 3, 0.3],
                        ["Cherry",10, 0.2]
                        ["Orange", true, 1.3],
                    ],
                    footer-data: [["Total", "", SUM(C1:C4)]],
                    draw-grid:true,
                    padding:1
                )
            }
            // Example 3: Class usage in a selector
            row{
                text("**Class Usage:**",font-size:2.5%P)
                @(highlight) table(
                    header-data: [["x", "y"]],
                    data: [
                    ["1", "2"]
                ],draw-grid:true,padding:1)
            }
        }
    }
}
